---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ProgramTable from '../components/ProgramTable.astro';
import { homeCrumb, routes } from '../data/routes';
import { breadcrumbLd, formatIdDate, siteIds, siteOrigin } from '../data/site';
import {
  bonusTypes,
  checks,
  eventIntro,
  faqs,
  intro,
  joinSteps,
  programReferralLead,
  programReferralMeta,
  related,
  tableCaption,
} from '../data/program-referral';
import { getBrands, sortBrandsByChecked } from '../lib/content';
import { indexableBrands } from '../lib/policy';
import { programReferralOgCard } from '../lib/og';

const brands = await getBrands();
const listed = sortBrandsByChecked(indexableBrands(brands));
const origin = siteOrigin(Astro.site);
const pageUrl = new URL(routes.programReferral.href, origin).toString();
const { website: websiteId, organization: organizationId } = siteIds(origin);
const webpageId = `${pageUrl}#webpage`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const itemListId = `${pageUrl}#itemlist`;
const faqId = `${pageUrl}#faq`;
const checkedThrough = listed[0] ? formatIdDate(listed[0].checkedAt) : 'tanggal cek belum tersedia';

const jsonLd = [
  breadcrumbLd(
    [
      homeCrumb,
      { name: routes.programReferral.label, path: routes.programReferral.href },
    ],
    origin,
    breadcrumbId,
  ),
  {
    '@type': 'CollectionPage',
    '@id': webpageId,
    name: 'Program referral dan event undang teman untuk pengundang',
    description: programReferralMeta.description,
    url: pageUrl,
    inLanguage: 'id',
    isPartOf: { '@id': websiteId },
    publisher: { '@id': organizationId },
    breadcrumb: { '@id': breadcrumbId },
    mainEntity: { '@id': itemListId },
  },
  {
    '@type': 'ItemList',
    '@id': itemListId,
    numberOfItems: listed.length,
    itemListElement: listed.map((brand, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `Program referral ${brand.name}`,
      url: new URL(`/kode-referral/${brand.slug}/`, origin).toString(),
    })),
  },
  {
    '@type': 'FAQPage',
    '@id': faqId,
    isPartOf: { '@id': websiteId },
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title={programReferralMeta.title}
  description={programReferralMeta.description}
  canonical={routes.programReferral.href}
  image={programReferralOgCard(listed)}
  jsonLd={jsonLd}
>
  <section class="page-head">
    <div class="container">
      <Breadcrumb
        items={[
          { label: routes.home.label, href: routes.home.href },
          { label: routes.programReferral.label },
        ]}
      />
      <div class="page-head__body">
        <h1>{programReferralMeta.h1}</h1>
        <p class="lead">{programReferralLead(listed.length)}</p>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="prose">
      <section class="prose-section">
        <h2>Apa itu program referral dan event undang teman?</h2>
        {intro.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      <section class="prose-section">
        <h2>Cara mengikuti event undang teman.</h2>
        <ol class="steps">
          {joinSteps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="prose-section">
        <h2>Bonus pengundang biasanya berbentuk apa?</h2>
        <ul>
          {bonusTypes.map((type) => (
            <li>
              <strong>{type.title}</strong> {type.body}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>

  <section class="ledger">
    <div class="container">
      <div class="section-head">
        <h2>Event dan program undang teman yang tercatat aktif.</h2>
        <p>{eventIntro}</p>
      </div>
      <ProgramTable items={listed} caption={tableCaption} />
      <p class="source-line">
        {listed.length} program dicek hingga {checkedThrough}.{' '}
        <a class="text-link" href={routes.methodology.href}>Baca cara pengecekan</a> dan{' '}
        <a class="text-link" href={routes.disclosure.href}>kebijakan tautan affiliate</a>.
      </p>
    </div>
  </section>

  <div class="container">
    <div class="prose">
      <section class="prose-section">
        <h2>Yang perlu dicek sebelum mengikuti event undang teman.</h2>
        <ul class="check-list">
          {checks.map((check) => (
            <li>
              <strong>{check.title}</strong> {check.body}
            </li>
          ))}
        </ul>
        <p>
          Sebelum membagikan tautan, baca{' '}
          <a href={routes.disclosure.href}>kebijakan tautan affiliate</a> dan{' '}
          <a href={routes.methodology.href}>cara kami mengecek program</a>.
        </p>
      </section>

      <section class="prose-section" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Pertanyaan tentang program referral.</h2>
        <div class="faq-list" id="faq">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="prose-section" aria-labelledby="baca-juga">
        <h2 id="baca-juga">Baca juga.</h2>
        <ul>
          {related.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>. {item.note}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
