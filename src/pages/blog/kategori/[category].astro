---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { blogCategoryName, type BlogCategory } from '../../../data/blog-categories';
import { ui } from '../../../data/copy';
import { homeCrumb, routes } from '../../../data/routes';
import { breadcrumbLd, formatIdDate, siteIds, siteOrigin } from '../../../data/site';
import { articlesInBlogCategory, getArticles } from '../../../lib/content';
import { indexableBlogCategories } from '../../../lib/policy';import { blogCategoryOgCard } from '../../../lib/og';

export async function getStaticPaths() {
  const articles = await getArticles();
  return indexableBlogCategories(articles).map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props as { category: BlogCategory };
const articles = await getArticles();
const listed = articlesInBlogCategory(articles, category.slug).sort((a, b) =>
  b.updated.localeCompare(a.updated),
);
const siblings = indexableBlogCategories(articles).filter((item) => item.slug !== category.slug);
const origin = siteOrigin(Astro.site);
const introParagraphs = category.intro.split(/\n\s*\n/).filter((paragraph) => paragraph.trim());
const pageUrl = new URL(`/blog/kategori/${category.slug}/`, origin).toString();
const { website: websiteId, organization: organizationId } = siteIds(origin);
const webpageId = `${pageUrl}#webpage`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const itemListId = `${pageUrl}#itemlist`;

const dayFormat = new Intl.DateTimeFormat('id-ID', { day: '2-digit', timeZone: 'UTC' });
const monthFormat = new Intl.DateTimeFormat('id-ID', { month: 'short', timeZone: 'UTC' });
const dated = listed.map((article) => {
  const date = new Date(`${article.updated}T00:00:00Z`);
  return {
    ...article,
    day: dayFormat.format(date),
    month: monthFormat.format(date),
  };
});

const jsonLd = [
  breadcrumbLd(
    [
      homeCrumb,
      { name: routes.blog.label, path: routes.blog.href },
      { name: routes.blogCategories.label, path: routes.blogCategories.href },
      { name: category.name, path: `/blog/kategori/${category.slug}/` },
    ],
    origin,
    breadcrumbId,
  ),
  {
    '@type': 'CollectionPage',
    '@id': webpageId,
    name: `${category.name}: panduan kode referral`,
    description: category.description,
    url: pageUrl,
    inLanguage: 'id',
    isPartOf: { '@id': websiteId },
    publisher: { '@id': organizationId },
    breadcrumb: { '@id': breadcrumbId },
    mainEntity: { '@id': itemListId },
  },
  {
    '@type': 'ItemList',
    '@id': itemListId,
    numberOfItems: listed.length,
    itemListElement: listed.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: new URL(`/blog/${article.slug}/`, origin).toString(),
    })),
  },
];
---

<BaseLayout
  title={`Kategori ${category.name}: panduan kode referral`}
  description={`${category.description} ${listed.length} artikel dengan sumber resmi.`}
  jsonLd={jsonLd}
  robots="index"
  image={blogCategoryOgCard(category, articles)}
>
  <section class="page-head">
    <div class="container">
      <Breadcrumb
        items={[
          { label: routes.home.label, href: routes.home.href },
          { label: routes.blog.label, href: routes.blog.href },
          { label: routes.blogCategories.label, href: routes.blogCategories.href },
          { label: category.name },
        ]}
      />
      <div class="page-head__body">
        <h1>{category.name}.</h1>
        <p class="lead">{category.description}</p>
      </div>
    </div>
  </section>

  <section class="archive">
    <div class="container">
      <h2 class="visually-hidden">Artikel kategori {blogCategoryName(category.slug)}</h2>
      <ol class="archive-list archive-list--category">
        {dated.map((article) => (
          <li>
            <a class="archive-entry" href={`/blog/${article.slug}/`}>
              <time class="archive-entry__date" datetime={article.updated}>
                <span class="archive-entry__day">{article.day}</span>
                <span class="archive-entry__month">{article.month}</span>
              </time>
              <span class="archive-entry__body">
                <h3>{article.title}</h3>
                <span class="archive-entry__excerpt">{article.excerpt}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>

      <p class="source-line">
        {listed.length} artikel di kategori {category.name}, diurutkan dari yang paling baru
        diperbarui. {ui.lastChecked}{' '}
        <time datetime={listed[0].updated}>{formatIdDate(listed[0].updated)}</time>.{' '}
        <a class="text-link" href={routes.blog.href}>Artikel lain</a>.
      </p>

      <div class="category-intro">
        {introParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      {siblings.length > 0 && (
        <p class="source-line">
          Kategori lain:{' '}
          {siblings.map((item, index) => (
            <>
              {index > 0 && ', '}
              <a class="text-link" href={`/blog/kategori/${item.slug}/`}>{item.name}</a>
            </>
          ))}
          .
        </p>
      )}
    </div>
  </section>
</BaseLayout>
