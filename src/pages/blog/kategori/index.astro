---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { homeCrumb, routes } from '../../../data/routes';
import { breadcrumbLd, siteIds, siteOrigin } from '../../../data/site';
import { articlesInBlogCategory, getArticles } from '../../../lib/content';
import { isBlogIndexable, indexableBlogCategories } from '../../../lib/policy';
import { blogCategoryIndexOgCard } from '../../../lib/og';

const articles = await getArticles();
const listed = indexableBlogCategories(articles);
const origin = siteOrigin(Astro.site);
const robots = isBlogIndexable(articles) && listed.length > 0 ? 'index' : 'noindex';
const pageUrl = new URL(routes.blogCategories.href, origin).toString();
const { website: websiteId, organization: organizationId } = siteIds(origin);
const webpageId = `${pageUrl}#webpage`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const itemListId = `${pageUrl}#itemlist`;

const jsonLd = [
  breadcrumbLd(
    [
      homeCrumb,
      { name: routes.blog.label, path: routes.blog.href },
      { name: routes.blogCategories.label, path: routes.blogCategories.href },
    ],
    origin,
    breadcrumbId,
  ),
  {
    '@type': 'CollectionPage',
    '@id': webpageId,
    name: 'Kategori panduan kode referral',
    description:
      'Kategori artikel kode referral: Knowledge, Review, Perbandingan, Verifikasi akun, dan Bonus pengguna baru.',
    url: pageUrl,
    inLanguage: 'id',
    isPartOf: { '@id': websiteId },
    publisher: { '@id': organizationId },
    breadcrumb: { '@id': breadcrumbId },
    mainEntity: { '@id': itemListId },
  },
  {
    '@type': 'ItemList',
    '@id': itemListId,
    numberOfItems: listed.length,
    itemListElement: listed.map((category, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: category.name,
      url: new URL(`/blog/kategori/${category.slug}/`, origin).toString(),
    })),
  },
];
---

<BaseLayout
  title="Kategori artikel kode referral"
  description="Kategori panduan kode referral: arti dan cara kerja, review, perbandingan brand, verifikasi akun, dan bonus pengguna baru."
  jsonLd={jsonLd}
  robots={robots}
  image={blogCategoryIndexOgCard(listed)}
>
  <section class="page-head">
    <div class="container">
      <Breadcrumb
        items={[
          { label: routes.home.label, href: routes.home.href },
          { label: routes.blog.label, href: routes.blog.href },
          { label: routes.blogCategories.label },
        ]}
      />
      <div class="page-head__body">
        <h1>Kategori panduan.</h1>
        <p class="lead">Pilih topik, lalu baca artikelnya berurutan dari yang paling baru diperbarui.</p>
      </div>
    </div>
  </section>

  <section class="categories">
    <div class="container">
      <ul class="index-list">
        {listed.map((category) => (
          <li class="index-row">
            <a href={`/blog/kategori/${category.slug}/`}>
              <span class="index-name">{category.name}</span>
              <span class="index-line">{category.line}</span>
              <span class="index-count">
                {articlesInBlogCategory(articles, category.slug).length} artikel
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="source-line">
        <a class="text-link" href={routes.blog.href}>Lihat semua artikel</a>.
      </p>
    </div>
  </section>
</BaseLayout>
