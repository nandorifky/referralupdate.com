---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogCategoryName } from '../../data/blog-categories';
import { breadcrumbLd, formatIdDate } from '../../data/site';
import { getArticles } from '../../lib/content';
import { isBlogIndexable } from '../../lib/policy';
import { blogIndexOgCard } from '../../lib/og';

const articles = (await getArticles()).sort((a, b) => b.updated.localeCompare(a.updated));
const origin = Astro.site ?? new URL('https://referralupdate.com');
const robots = isBlogIndexable(articles) ? 'index' : 'noindex';
const blogCategories = [...new Set(articles.map((article) => article.category))].map((slug) => {
  const items = articles.filter((article) => article.category === slug);
  return { slug, name: blogCategoryName(slug), count: items.length };
});

const dayFormat = new Intl.DateTimeFormat('id-ID', { day: '2-digit', timeZone: 'UTC' });
const monthFormat = new Intl.DateTimeFormat('id-ID', { month: 'short', timeZone: 'UTC' });
const dated = articles.map((article) => {
  const date = new Date(`${article.updated}T00:00:00Z`);
  return {
    ...article,
    day: dayFormat.format(date),
    month: monthFormat.format(date),
    year: article.updated.slice(0, 4),
  };
});
const years = [...new Set(dated.map((article) => article.year))].map((year) => ({
  year,
  items: dated.filter((article) => article.year === year),
}));

const jsonLd = [
  breadcrumbLd(
    [
      { name: 'Beranda', path: '/' },
      { name: 'Blog', path: '/blog/' },
    ],
    origin,
  ),
  {
    '@type': 'CollectionPage',
    name: 'Blog Referral Update',
    description: 'Panduan kode referral: pengertian, beda dengan kode promo, keamanan, dan cara klaim bonus.',
    url: new URL('/blog/', origin).toString(),
    inLanguage: 'id',
  },
  {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: new URL(`/blog/${article.slug}/`, origin).toString(),
    })),
  },
];
---

<BaseLayout
  title="Blog kode referral: panduan dan cara pakai"
  description="Panduan kode referral: pengertian, beda dengan kode promo, keamanan, dan cara klaim bonus. Ditulis dengan sumber resmi."
  jsonLd={jsonLd}
  robots={robots}
  image={blogIndexOgCard(articles)}
>
  <section class="page-head">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Beranda</a></li>
          <li>Blog</li>
        </ol>
      </nav>
      <div class="page-head__body">
        <h1>Panduan kode referral.</h1>
        <p class="lead">Artikel tentang pengertian, cara pakai, keamanan, dan bonus referral.</p>
      </div>
    </div>
  </section>

  <section class="archive">
    <div class="container">
      <div class="archive__summary">
        <div class="archive__summary-copy">
          <p class="archive__count">{articles.length} artikel di {blogCategories.length} kategori.</p>
          <p class="archive__updated">
            Terakhir diperbarui <time datetime={articles[0].updated}>{formatIdDate(articles[0].updated)}</time>.
          </p>
          <p class="source-line">Semua artikel memakai sumber resmi. <a class="text-link" href="/metodologi-verifikasi/">Baca metodologi</a>.</p>
        </div>
        <ul class="archive__categories">
          {blogCategories.map((category) => (
            <li><span>{category.name}</span><span>({category.count})</span></li>
          ))}
        </ul>
      </div>

      <h2 class="visually-hidden">Semua artikel</h2>
      {years.map((group) => (
        <section class="archive-year" aria-labelledby={`tahun-${group.year}`}>
          <header class="archive-year__head">
            <h2 class="archive-year__label" id={`tahun-${group.year}`}>{group.year}</h2>
            <p class="archive-year__count">{group.items.length} artikel</p>
          </header>
          <ol class="archive-list">
            {group.items.map((article) => (
              <li>
                <a class="archive-entry" href={`/blog/${article.slug}/`}>
                  <time class="archive-entry__date" datetime={article.updated}>
                    <span class="archive-entry__day">{article.day}</span>
                    <span class="archive-entry__month">{article.month}</span>
                  </time>
                  <span class="archive-entry__body">
                    <h3>{article.title}</h3>
                    <span class="archive-entry__excerpt">{article.excerpt}</span>
                  </span>
                  <span class="archive-entry__cat">{blogCategoryName(article.category)}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
