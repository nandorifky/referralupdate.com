---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogCategoryName } from '../../data/blog-categories';
import { breadcrumbLd, formatIdDate, photos } from '../../data/site';
import { getArticles } from '../../lib/content';
import { isBlogIndexable } from '../../lib/policy';

const articles = (await getArticles()).sort((a, b) => b.updated.localeCompare(a.updated));
const origin = Astro.site ?? new URL('https://kode-referral.example');
const robots = isBlogIndexable(articles) ? 'index' : 'noindex';
const blogCategories = [...new Set(articles.map((article) => article.category))].map((slug) => {
  const items = articles.filter((article) => article.category === slug);
  return { slug, name: blogCategoryName(slug), count: items.length };
});

const dayFormat = new Intl.DateTimeFormat('id-ID', { day: '2-digit', timeZone: 'UTC' });
const monthFormat = new Intl.DateTimeFormat('id-ID', { month: 'short', timeZone: 'UTC' });
const dated = articles.map((article) => {
  const date = new Date(`${article.updated}T00:00:00Z`);
  return {
    ...article,
    day: dayFormat.format(date),
    month: monthFormat.format(date),
    year: article.updated.slice(0, 4),
  };
});
const years = [...new Set(dated.map((article) => article.year))].map((year) => ({
  year,
  items: dated.filter((article) => article.year === year),
}));

const jsonLd = [
  breadcrumbLd(
    [
      { name: 'Beranda', path: '/' },
      { name: 'Blog', path: '/blog/' },
    ],
    origin,
  ),
  {
    '@type': 'CollectionPage',
    name: 'Blog KodeReferral',
    description: 'Panduan tentang kode referral, keamanan, dan cara mencairkan bonus.',
    url: new URL('/blog/', origin).toString(),
    inLanguage: 'id',
  },
  {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: new URL(`/blog/${article.slug}/`, origin).toString(),
    })),
  },
];
---

<BaseLayout
  title="Blog"
  description="Panduan kode referral: cara kerja, perbedaan dengan kode promo, keamanan, dan cara mencairkan bonus."
  jsonLd={jsonLd}
  robots={robots}
>
  <section class="page-head">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Beranda</a></li>
          <li>Blog</li>
        </ol>
      </nav>
      <div class="page-head__body">
        <h1>Arsip catatan.</h1>
        <p class="lead">Semua tulisan soal syarat, keamanan, dan bonus, diurutkan dari yang terbaru.</p>
      </div>
    </div>
  </section>

  <section class="archive">
    <div class="container archive__grid">
      <aside class="archive__aside">
        <p class="archive__count">
          {articles.length} catatan di {blogCategories.length} kategori. Terakhir diperbarui{' '}
          {formatIdDate(articles[0].updated)}.
        </p>
        <figure>
          <div class="slot slot--4x5" data-slot="blog" data-alt={photos.blog.alt}>
            <img
              src={photos.blog.src}
              alt={photos.blog.alt}
              width="1920"
              height="1280"
              style={`object-position: ${photos.blog.position}`}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="caption">Kami menulis soal syarat yang tertulis, bukan janji di kolom komentar.</figcaption>
        </figure>
        <div class="archive__cats">
          <p class="aside-title">Kategori</p>
          <ul class="archive__cat-list">
            {blogCategories.map((category) => (
              <li><span>{category.name}</span><span>{category.count} tulisan</span></li>
            ))}
          </ul>
        </div>
        <p class="source-line">Semua tulisan memakai sumber resmi. <a class="text-link" href="/metodologi-verifikasi/">Baca metodologi</a>.</p>
      </aside>

      <div class="archive__main">
        <h2 class="visually-hidden">Semua catatan</h2>
        {years.map((group) => (
          <section class="archive-year" aria-labelledby={`tahun-${group.year}`}>
            <h2 class="archive-year__label" id={`tahun-${group.year}`}>{group.year}</h2>
            <ol class="archive-list">
              {group.items.map((article) => (
                <li>
                  <a class="archive-entry" href={`/blog/${article.slug}/`}>
                    <time class="archive-entry__date" datetime={article.updated}>
                      <span class="archive-entry__day">{article.day}</span>
                      <span class="archive-entry__month">{article.month}</span>
                    </time>
                    <span class="archive-entry__body">
                      <h3>{article.title}</h3>
                      <span class="archive-entry__cat">{blogCategoryName(article.category)}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
