---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogCategoryName } from '../../data/blog-categories';
import { breadcrumbLd, formatIdDate, photos } from '../../data/site';
import { getArticles, getBrands, type Article } from '../../lib/content';
import { isArticleIndexable } from '../../lib/policy';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: Article };
const articles = await getArticles();
const brands = await getBrands();
const relatedBrands = brands.filter((brand) => article.relatedBrands.includes(brand.slug));
const otherArticles = articles.filter((item) => item.slug !== article.slug).slice(0, 2);
const categoryName = blogCategoryName(article.category);
const { Content } = await render(article.entry);
const robots = isArticleIndexable(article) ? 'index' : 'noindex';
const origin = Astro.site ?? new URL('https://kode-referral.example');

const jsonLd = [
  breadcrumbLd(
    [
      { name: 'Beranda', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: article.title, path: `/blog/${article.slug}/` },
    ],
    origin,
  ),
  {
    '@type': 'BlogPosting',
    headline: article.title,
    description: article.excerpt,
    datePublished: article.updated,
    dateModified: article.updated,
    inLanguage: 'id',
    articleSection: categoryName,
    url: new URL(`/blog/${article.slug}/`, origin).toString(),
    mainEntityOfPage: new URL(`/blog/${article.slug}/`, origin).toString(),
    author: { '@type': 'Organization', name: article.author.name },
    publisher: { '@type': 'Organization', name: 'KodeReferral' },
    citation: article.sources.map((source) => source.url),
  },
];
---

<BaseLayout
  title={article.title}
  description={article.excerpt}
  ogType="article"
  robots={robots}
  jsonLd={jsonLd}
>
  <article>
    <section class="article-head">
      <div class="container">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb">
            <li><a href="/">Beranda</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li>{categoryName}</li>
            <li>{article.title}</li>
          </ol>
        </nav>
        <div class="article-head__grid">
          <div class="article-head__copy">
            <h1>{article.title}</h1>
            <p class="lead">{article.excerpt}</p>
          </div>
          <dl class="article-meta">
            <div>
              <dt>Kategori</dt>
              <dd>{categoryName}</dd>
            </div>
            <div>
              <dt>Diperbarui</dt>
              <dd>{formatIdDate(article.updated)}</dd>
            </div>
            <div>
              <dt>Penulis</dt>
              <dd>{article.author.name}, {article.author.role}</dd>
            </div>
          </dl>
        </div>

        <figure class="article-figure">
          <div class="slot slot--wide" data-slot="article" data-alt={photos.article.alt}>
            <img
              src={photos.article.src}
              alt={photos.article.alt}
              width="1920"
              height="1280"
              style={`object-position: ${photos.article.position}`}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <figcaption class="caption">Catatan ini bersumber dari halaman resmi, bukan rekap forum.</figcaption>
        </figure>
      </div>
    </section>

    <section class="article-body">
      <div class="container">
        <div class="article-body__inner">
          <Content />

          <div class="article-sources">
            <h2>Sumber</h2>
            <ul>
              {article.sources.map((source) => (
                <li>
                  <a href={source.url} rel="noopener noreferrer" target="_blank">{source.label}</a>
                </li>
              ))}
            </ul>
            <p><a class="text-link" href="/metodologi-verifikasi/">Baca metodologi verifikasi</a>.</p>
          </div>

          <p class="author-box">
            oleh {article.author.name}, {article.author.role}. Diperbarui {formatIdDate(article.updated)}.
            Koreksi lewat halaman kontak.
          </p>
        </div>
      </div>
    </section>
  </article>

  {(relatedBrands.length > 0 || otherArticles.length > 0) && (
    <section class="article-end">
      {relatedBrands.length > 0 && (
        <div class="article-cta field">
          <div class="container">
            <h2>Kode untuk brand di artikel ini.</h2>
            <div class="cta-grid">
              {relatedBrands.map((brand) => (
                <a class="cta-item" href={`/kode-referral/${brand.slug}/`}>
                  <span class="cta-name">{brand.name}</span>
                  <span class="cta-code">{brand.code}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      )}

      {otherArticles.length > 0 && (
        <div class="related-articles">
          <div class="container">
            <div class="section-head">
              <h2>Baca juga.</h2>
              <p>Tulisan lain dengan sumber yang sama-sama terbuka.</p>
            </div>
            <div class="blog-list">
              {otherArticles.map((item) => (
                <a class="blog-row" href={`/blog/${item.slug}/`}>
                  <h3>{item.title}</h3>
                  <p>{blogCategoryName(item.category)}, diperbarui {formatIdDate(item.updated)}</p>
                </a>
              ))}
              <a class="blog-row" href="/blog/">
                <h3>Semua tulisan</h3>
                <p>Arsip blog</p>
              </a>
            </div>
          </div>
        </div>
      )}
    </section>
  )}
</BaseLayout>
