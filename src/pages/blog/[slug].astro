---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  articles,
  getBrand,
  breadcrumbLd,
  isoDate,
  type Article,
  type Brand,
} from '../../data/site';

type ArticleProps = { kind: 'article'; article: Article };
type CategoryProps = { kind: 'category'; name: string; slug: string; items: Article[] };

export function getStaticPaths() {
  const categorySlugs = [...new Set(articles.map((article) => article.category))];
  return [
    ...articles.map((article) => ({
      params: { slug: article.slug },
      props: { kind: 'article' as const, article },
    })),
    ...categorySlugs.map((slug) => {
      const items = articles.filter((article) => article.category === slug);
      return {
        params: { slug },
        props: { kind: 'category' as const, name: items[0].categoryName, slug, items },
      };
    }),
  ];
}

const data = Astro.props as ArticleProps | CategoryProps;
const article = data.kind === 'article' ? data.article : null;
const category = data.kind === 'category' ? data : null;
const origin = Astro.site ?? new URL('https://kode-referral.example');

const pageTitle = article ? article.title : category!.name;
const description = article
  ? article.excerpt
  : `${category!.items.length} tulisan tentang ${category!.name.toLowerCase()} di blog KodeReferral.`;

const relatedBrands = article
  ? (article.relatedBrands.map((slug) => getBrand(slug)).filter(Boolean) as Brand[])
  : [];
const otherArticles = article
  ? articles.filter((item) => item.slug !== article.slug).slice(0, 2)
  : [];

const jsonLd = article
  ? [
      breadcrumbLd(
        [
          { name: 'Beranda', path: '/' },
          { name: 'Blog', path: '/blog/' },
          { name: article.categoryName, path: `/blog/${article.category}/` },
          { name: article.title, path: `/blog/${article.slug}/` },
        ],
        origin,
      ),
      {
        '@type': 'BlogPosting',
        headline: article.title,
        description: article.excerpt,
        datePublished: isoDate(article.updated),
        dateModified: isoDate(article.updated),
        inLanguage: 'id',
        articleSection: article.categoryName,
        url: new URL(`/blog/${article.slug}/`, origin).toString(),
        mainEntityOfPage: new URL(`/blog/${article.slug}/`, origin).toString(),
        author: { '@type': 'Organization', name: article.author },
        publisher: { '@type': 'Organization', name: 'KodeReferral' },
      },
    ]
  : [
      breadcrumbLd(
        [
          { name: 'Beranda', path: '/' },
          { name: 'Blog', path: '/blog/' },
          { name: category!.name, path: `/blog/${category!.slug}/` },
        ],
        origin,
      ),
      {
        '@type': 'CollectionPage',
        name: category!.name,
        url: new URL(`/blog/${category!.slug}/`, origin).toString(),
        inLanguage: 'id',
      },
      {
        '@type': 'ItemList',
        numberOfItems: category!.items.length,
        itemListElement: category!.items.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.title,
          url: new URL(`/blog/${item.slug}/`, origin).toString(),
        })),
      },
    ];
---

<BaseLayout title={pageTitle} description={description} ogType={article ? 'article' : 'website'} jsonLd={jsonLd}>
  {article && (
    <>
      <article>
        <div class="container">
          <section class="article-head">
            <nav aria-label="Breadcrumb">
              <ol class="breadcrumb">
                <li><a href="/">Beranda</a></li>
                <li><a href="/blog/">Blog</a></li>
                <li><a href={`/blog/${article.category}/`}>{article.categoryName}</a></li>
                <li>{article.title}</li>
              </ol>
            </nav>
            <div class="article-head__inner">
              <h1>{article.title}</h1>
              <p class="lead">{article.excerpt}</p>
            </div>
          </section>

          <div class="article-body">
            <div class="article-body__inner">
              {article.sections.map((section) => (
                <div class="article-section">
                  <h2>{section.heading}</h2>
                  {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                  {section.list && (
                    <ul>
                      {section.list.map((item) => <li>{item}</li>)}
                    </ul>
                  )}
                </div>
              ))}

              <div class="article-sources">
                <p>Sumber: halaman program resmi brand dan aplikasinya. Tanggal cek ada di setiap halaman brand.</p>
                <p><a class="text-link" href="/metodologi-verifikasi/">Baca metodologi verifikasi</a>.</p>
              </div>

              <div class="author-box">
                <p>oleh {article.author}, diperbarui {article.updated}. Panduan ini ditulis dan dicek ulang. Koreksi bisa dikirim lewat halaman kontak.</p>
              </div>
            </div>
          </div>
        </div>
      </article>

      {relatedBrands.length > 0 && (
        <section class="article-cta">
          <div class="container">
            <h2>Kode untuk brand di artikel ini</h2>
            <div class="cta-grid">
              {relatedBrands.map((brand) => (
                <a class="cta-item" href={`/kode-referral/${brand.slug}/`}>
                  <span class="cta-name">{brand.name}</span>
                  <span class="cta-code">{brand.code}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      {otherArticles.length > 0 && (
        <section class="related-articles">
          <div class="container">
            <div class="section-head">
              <h2>Baca juga</h2>
            </div>
            <div class="blog-list">
              {otherArticles.map((item) => (
                <a class="blog-row stock" href={`/blog/${item.slug}/`}>
                  <h3>{item.title}</h3>
                  <p>{item.categoryName}, diperbarui {item.updated}</p>
                </a>
              ))}
              <a class="blog-row stock" href="/blog/">
                <h3>Semua tulisan</h3>
                <p>Arsip blog</p>
              </a>
            </div>
          </div>
        </section>
      )}
    </>
  )}

  {category && (
    <div class="container">
      <section class="index-head">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb">
            <li><a href="/">Beranda</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li>{category.name}</li>
          </ol>
        </nav>
        <div class="index-head__body">
          <h1>{category.name}: panduan kode referral.</h1>
          <p class="lead">{category.items.length} tulisan tentang {category.name.toLowerCase()}.</p>
        </div>
      </section>

      <div class="blog-list">
        <h2 class="visually-hidden">Daftar tulisan</h2>
        {category.items.map((item) => (
          <a class="blog-row" href={`/blog/${item.slug}/`}>
            <h3>{item.title}</h3>
            <p>Diperbarui {item.updated}</p>
          </a>
        ))}
      </div>

      <p class="source-line"><a class="text-link" href="/blog/">Kembali ke semua tulisan</a>.</p>
    </div>
  )}
</BaseLayout>
