---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BannerSlot from '../../components/BannerSlot.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SectionHead from '../../components/SectionHead.astro';
import Toc from '../../components/Toc.astro';
import ResponsivePhoto from '../../components/ResponsivePhoto.astro';
import { blogCategoryName } from '../../data/blog-categories';
import { relatedArticles } from '../../data/related-articles';
import { homeCrumb, routes } from '../../data/routes';
import { breadcrumbLd, formatIdDate, siteIds, siteOrigin } from '../../data/site';
import { getArticles, getBrands, sortArticlesByUpdated, type Article } from '../../lib/content';
import { indexableBlogCategories, isArticleIndexable } from '../../lib/policy';
import { articleOgCard } from '../../lib/og';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: Article };
const articles = await getArticles();
const brands = await getBrands();
const relatedBrands = brands.filter((brand) => article.relatedBrands.includes(brand.slug));
const curated = (relatedArticles[article.slug] ?? [])
  .map((slug) => articles.find((item) => item.slug === slug))
  .filter((item): item is Article => Boolean(item) && item.slug !== article.slug);
const curatedSlugs = new Set(curated.map((item) => item.slug));
const siblingArticles = articles.filter(
  (item) => item.slug !== article.slug && !curatedSlugs.has(item.slug),
);
const sameCategory = sortArticlesByUpdated(
  siblingArticles.filter((item) => item.category === article.category),
);
const sameBrand = sortArticlesByUpdated(
  siblingArticles.filter(
    (item) =>
      item.category !== article.category &&
      item.relatedBrands.some((slug) => article.relatedBrands.includes(slug)),
  ),
);
const fallbackSlugs = new Set([...sameCategory, ...sameBrand].map((item) => item.slug));
const fallbackArticles = sortArticlesByUpdated(
  siblingArticles.filter((item) => !fallbackSlugs.has(item.slug)),
);
const otherArticles = [
  ...curated,
  ...sameCategory,
  ...sameBrand,
  ...fallbackArticles,
].slice(0, 3);
const categoryName = blogCategoryName(article.category);
const categoryArchive = indexableBlogCategories(articles).find(
  (category) => category.slug === article.category,
);
const categoryPath = categoryArchive ? `/blog/kategori/${categoryArchive.slug}/` : undefined;
const { Content, headings } = await render(article.entry);
const robots = isArticleIndexable(article) ? 'index' : 'noindex';
const origin = siteOrigin(Astro.site);
const articleUrl = new URL(`/blog/${article.slug}/`, origin).toString();
const { website: websiteId, organization: organizationId } = siteIds(origin);
const articleId = `${articleUrl}#article`;
const breadcrumbId = `${articleUrl}#breadcrumb`;
const published = article.published ?? article.updated;
const publishedIso = new Date(`${published}T00:00:00+07:00`).toISOString();
const updatedIso = new Date(`${article.updated}T00:00:00+07:00`).toISOString();
const coverImage = await getImage({
  src: article.image.src,
  width: 1200,
  format: 'jpg',
  quality: 80,
});
const imageUrl = new URL(coverImage.src, origin).toString();
const toc = [
  ...headings
    .filter((heading) => heading.depth === 2)
    .map((heading) => ({ href: `#${heading.slug}`, label: heading.text })),
  { href: '#sumber', label: 'Sumber' },
];
const tags = [categoryName, ...relatedBrands.map((brand) => brand.name)];

const jsonLd = [
  breadcrumbLd(
    [
      homeCrumb,
      { name: routes.blog.label, path: routes.blog.href },
      ...(categoryPath ? [{ name: categoryName, path: categoryPath }] : []),
      { name: article.title, path: `/blog/${article.slug}/` },
    ],
    origin,
    breadcrumbId,
  ),
  {
    '@type': 'BlogPosting',
    '@id': articleId,
    headline: article.title,
    description: article.excerpt,
    datePublished: publishedIso,
    dateModified: updatedIso,
    image: imageUrl,
    inLanguage: 'id',
    articleSection: categoryName,
    keywords: tags.join(', '),
    url: articleUrl,
    mainEntityOfPage: articleUrl,
    isPartOf: { '@id': websiteId },
    author: {
      '@type': 'Person',
      name: article.author.name,
      jobTitle: article.author.role,
      worksFor: { '@id': organizationId },
    },
    publisher: { '@id': organizationId },
    citation: article.sources.map((source) => source.url),
  },
];
---

<BaseLayout
  title={article.title}
  description={article.excerpt}
  ogType="article"
  robots={robots}
  image={articleOgCard(article)}
  jsonLd={jsonLd}
  publishedTime={publishedIso}
  modifiedTime={updatedIso}
  section={categoryName}
  tags={tags}
  author={article.author.name}
>
  <article>
    <section class="article-head">
      <div class="container">
        <Breadcrumb
          items={[
            { label: routes.home.label, href: routes.home.href },
            { label: routes.blog.label, href: routes.blog.href },
            { label: categoryName, href: categoryPath },
            { label: article.title },
          ]}
        />
        <div class="article-head__grid">
          <div class="article-head__copy">
            <h1>{article.title}</h1>
            <p class="lead">{article.excerpt}</p>
          </div>
          <dl class="article-meta">
            <div>
              <dt>Kategori</dt>
              <dd>
                {categoryPath ? <a class="text-link" href={categoryPath}>{categoryName}</a> : categoryName}
              </dd>
            </div>
            <div>
              <dt>Diperbarui</dt>
              <dd><time datetime={article.updated}>{formatIdDate(article.updated)}</time></dd>
            </div>
            <div>
              <dt>Penulis</dt>
              <dd>{article.author.name}, {article.author.role}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <div class="article-cover">
      <div class="container">
        <figure class="article-figure">
          <div class="slot">
            <ResponsivePhoto
              photo={article.image}
              sizes="(max-width: 40rem) calc(100vw - 2rem), 44rem"
              widths={[480, 640, 960, 1280]}
              eager
            />
          </div>
          <figcaption class="caption">{article.image.caption}</figcaption>
        </figure>
      </div>
    </div>
    
    <section class="article-body">
      <div class="container">
        <div class="article-body__inner">
          <Toc items={toc} />
          <BannerSlot id="article-inline" />
          <Content />

          <div class="article-sources">
            <h2 id="sumber">Sumber</h2>
            <ul>
              {article.sources.map((source) => (
                <li>
                  <a href={source.url} rel="noopener noreferrer" target="_blank">{source.label}</a>
                </li>
              ))}
            </ul>
            <!--<p><a class="text-link" href="/metodologi-verifikasi/">Baca cara kami mengecek kode</a>.</p>-->
          </div>

          <p class="author-box">
            oleh {article.author.name}, {article.author.role}. Diperbarui{' '}
            <time datetime={article.updated}>{formatIdDate(article.updated)}</time>.
          </p>

          <BannerSlot id="article-inline" />
        </div>
      </div>
    </section>
  </article>

  {(relatedBrands.length > 0 || otherArticles.length > 0) && (
    <section class="article-end">
      {relatedBrands.length > 0 && (
        <div class="article-cta field">
          <div class="container">
            <h2>Gunakan kode referral di bawah dan dapatkan keuntungan.</h2>
            <div class="cta-grid">
              {relatedBrands.map((brand) => (
                <a class="cta-item" href={`/kode-referral/${brand.slug}/`}>
                  <span class="cta-kicker">Kode referral</span>
                  <span class="cta-name">{brand.name}</span>
                  <span class="cta-code">{brand.code}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      )}

      {otherArticles.length > 0 && (
        <div class="related-articles">
          <div class="container">
            <SectionHead
              title="Artikel terkait."
              intro="Baca juga artikel lainnya yang relevan dengan topik ini."
            />
            <div class="blog-list">
              {otherArticles.map((item) => (
                <a class="blog-row" href={`/blog/${item.slug}/`}>
                  <h3>{item.title}</h3>
                  <p>{blogCategoryName(item.category)}, diperbarui {formatIdDate(item.updated)}</p>
                </a>
              ))}
              <a class="blog-row" href={routes.blog.href}>
                <h3>Semua artikel</h3>
                <p>Daftar panduan kode referral</p>
              </a>
            </div>
          </div>
        </div>
      )}
    </section>
  )}
</BaseLayout>
