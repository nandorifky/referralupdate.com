---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import ResponsivePhoto from '../../components/ResponsivePhoto.astro';
import { blogCategoryName } from '../../data/blog-categories';
import { breadcrumbLd, formatIdDate, site } from '../../data/site';
import { getArticles, getBrands, type Article } from '../../lib/content';
import { isArticleIndexable } from '../../lib/policy';
import { articleOgCard } from '../../lib/og';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: Article };
const articles = await getArticles();
const brands = await getBrands();
const relatedBrands = brands.filter((brand) => article.relatedBrands.includes(brand.slug));
const otherArticles = articles.filter((item) => item.slug !== article.slug).slice(0, 2);
const categoryName = blogCategoryName(article.category);
const { Content, headings } = await render(article.entry);
const robots = isArticleIndexable(article) ? 'index' : 'noindex';
const origin = Astro.site ?? new URL('https://referralupdate.com');
const organizationRef = `${new URL('/', origin).toString()}#organization`;
const published = article.published ?? article.updated;
const publishedIso = new Date(`${published}T00:00:00+07:00`).toISOString();
const updatedIso = new Date(`${article.updated}T00:00:00+07:00`).toISOString();
const coverImage = await getImage({
  src: article.image.src,
  width: 1200,
  format: 'jpg',
  quality: 80,
});
const imageUrl = new URL(coverImage.src, origin).toString();
const toc = [
  ...headings
    .filter((heading) => heading.depth === 2)
    .map((heading) => ({ href: `#${heading.slug}`, label: heading.text })),
  { href: '#sumber', label: 'Sumber' },
];
const tags = [categoryName, ...relatedBrands.map((brand) => brand.name)];

const jsonLd = [
  breadcrumbLd(
    [
      { name: 'Beranda', path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: article.title, path: `/blog/${article.slug}/` },
    ],
    origin,
  ),
  {
    '@type': 'BlogPosting',
    headline: article.title,
    description: article.excerpt,
    datePublished: published,
    dateModified: article.updated,
    image: imageUrl,
    inLanguage: 'id',
    articleSection: categoryName,
    keywords: tags.join(', '),
    url: new URL(`/blog/${article.slug}/`, origin).toString(),
    mainEntityOfPage: new URL(`/blog/${article.slug}/`, origin).toString(),
    author: {
      '@type': 'Organization',
      name: article.author.name,
      url: new URL('/tentang/', origin).toString(),
    },
    publisher: {
      '@type': 'Organization',
      '@id': organizationRef,
      name: site.name,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/brand-mark-512.png', origin).toString(),
        width: 512,
        height: 512,
      },
    },
    citation: article.sources.map((source) => source.url),
  },
];
---

<BaseLayout
  title={article.title}
  description={article.excerpt}
  ogType="article"
  robots={robots}
  image={articleOgCard(article)}
  jsonLd={jsonLd}
  publishedTime={publishedIso}
  modifiedTime={updatedIso}
  section={categoryName}
  tags={tags}
  author={article.author.name}
>
  <article>
    <section class="article-head">
      <div class="container">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb">
            <li><a href="/">Beranda</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li>{categoryName}</li>
            <li>{article.title}</li>
          </ol>
        </nav>
        <div class="article-head__grid">
          <div class="article-head__copy">
            <h1>{article.title}</h1>
            <p class="lead">{article.excerpt}</p>
          </div>
          <dl class="article-meta">
            <div>
              <dt>Kategori</dt>
              <dd>{categoryName}</dd>
            </div>
            <div>
              <dt>Diperbarui</dt>
              <dd><time datetime={article.updated}>{formatIdDate(article.updated)}</time></dd>
            </div>
            <div>
              <dt>Penulis</dt>
              <dd>{article.author.name}, {article.author.role}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <div class="article-cover">
      <div class="container">
        <figure class="article-figure">
          <div class="slot">
            <ResponsivePhoto
              photo={article.image}
              sizes="(max-width: 40rem) calc(100vw - 2rem), 44rem"
              widths={[480, 640, 960, 1280]}
              eager
            />
          </div>
          <figcaption class="caption">{article.image.caption}</figcaption>
        </figure>
      </div>
    </div>

    <section class="article-body">
      <div class="container">
        <div class="article-body__inner">
          <Toc items={toc} />
          <Content />

          <div class="article-sources">
            <h2 id="sumber">Sumber</h2>
            <ul>
              {article.sources.map((source) => (
                <li>
                  <a href={source.url} rel="noopener noreferrer" target="_blank">{source.label}</a>
                </li>
              ))}
            </ul>
            <!--<p><a class="text-link" href="/metodologi-verifikasi/">Baca cara kami mengecek kode</a>.</p>-->
          </div>

          <p class="author-box">
            oleh {article.author.name}, {article.author.role}. Diperbarui{' '}
            <time datetime={article.updated}>{formatIdDate(article.updated)}</time>.
          </p>
        </div>
      </div>
    </section>
  </article>

  {(relatedBrands.length > 0 || otherArticles.length > 0) && (
    <section class="article-end">
      {relatedBrands.length > 0 && (
        <div class="article-cta field">
          <div class="container">
            <h2>Gunakan kode referral dibawah dan dapatkan keuntungan.</h2>
            <div class="cta-grid">
              {relatedBrands.map((brand) => (
                <a class="cta-item" href={`/kode-referral/${brand.slug}/`}>
                  <span class="cta-name">{brand.name}</span>
                  <span class="cta-code">{brand.code}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      )}

      {otherArticles.length > 0 && (
        <div class="related-articles">
          <div class="container">
            <div class="section-head">
              <h2>Artikel terkait.</h2>
              <p>Baca juga artikel lainnya yang relevan dengan topik ini.</p>
            </div>
            <div class="blog-list">
              {otherArticles.map((item) => (
                <a class="blog-row" href={`/blog/${item.slug}/`}>
                  <h3>{item.title}</h3>
                  <p>{blogCategoryName(item.category)}, diperbarui {formatIdDate(item.updated)}</p>
                </a>
              ))}
              <a class="blog-row" href="/blog/">
                <h3>Semua artikel</h3>
                <p>Daftar panduan kode referral</p>
              </a>
            </div>
          </div>
        </div>
      )}
    </section>
  )}
</BaseLayout>
