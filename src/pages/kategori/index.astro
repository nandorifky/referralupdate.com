---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { brandsByCategory, categories, breadcrumbLd } from '../../data/site';

const origin = Astro.site ?? new URL('https://kode-referral.example');
const jsonLd = [
  breadcrumbLd(
    [
      { name: 'Beranda', path: '/' },
      { name: 'Kategori', path: '/kategori/' },
    ],
    origin,
  ),
  {
    '@type': 'CollectionPage',
    name: 'Kategori kode referral',
    url: new URL('/kategori/', origin).toString(),
    inLanguage: 'id',
  },
];
---

<BaseLayout
  title="Kategori kode referral"
  description="Kode referral menurut kategori: e-wallet, bank digital, investasi, e-commerce, travel, food delivery, dan SaaS."
  jsonLd={jsonLd}
>
  <div class="container">
    <section class="index-head">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Beranda</a></li>
          <li>Kategori</li>
        </ol>
      </nav>
      <div class="index-head__body">
        <h1>Kategori kode referral.</h1>
        <p class="lead">Pilih jenis layanan yang kamu pakai, lalu bandingkan syarat dan tanggal ceknya.</p>
      </div>
    </section>

    <ul class="index-list">
      {categories.map((category) => {
        const count = brandsByCategory(category.slug).length;
        return (
          <li class="index-row">
            <a href={`/kategori/${category.slug}/`}>
              <span class="index-name">{category.name}</span>
              <span class="index-line">{category.line}</span>
              <span class="index-brands">{count} brand</span>
            </a>
          </li>
        );
      })}
    </ul>

    <p class="source-line"><a class="text-link" href="/kode-referral/">Lihat semua brand di direktori</a>.</p>
  </div>
</BaseLayout>
