---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../data/categories';
import { breadcrumbLd } from '../../data/site';
import { brandsInCategory, getBrands } from '../../lib/content';
import { categoryHref, indexableCategories } from '../../lib/policy';

const brands = await getBrands();
const origin = Astro.site ?? new URL('https://kode-referral.example');
const robots = indexableCategories(categories, brands).length > 0 ? 'index' : 'noindex';
const jsonLd = [
  breadcrumbLd(
    [
      { name: 'Beranda', path: '/' },
      { name: 'Kategori', path: '/kategori/' },
    ],
    origin,
  ),
  {
    '@type': 'CollectionPage',
    name: 'Kategori kode referral',
    url: new URL('/kategori/', origin).toString(),
    inLanguage: 'id',
  },
];
---

<BaseLayout
  title="Kategori kode referral"
  description="Kode referral menurut kategori: e-wallet, bank digital, investasi, e-commerce, travel, food delivery, dan SaaS."
  jsonLd={jsonLd}
  robots={robots}
>
  <section class="page-head">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Beranda</a></li>
          <li>Kategori</li>
        </ol>
      </nav>
      <div class="page-head__body">
        <h1>Kategori kode referral.</h1>
        <p class="lead">Pilih jenis layanan yang kamu pakai, lalu bandingkan syarat dan tanggal ceknya.</p>
      </div>
    </div>
  </section>

  <section class="categories">
    <div class="container">
      <ul class="index-list">
        {categories.map((category) => {
          const count = brandsInCategory(brands, category.slug).length;
          return (
            <li class="index-row">
              <a href={categoryHref(category, brands)}>
                <span class="index-name">{category.name}</span>
                <span class="index-line">{category.line}</span>
                <span class="index-count">{count} brand</span>
              </a>
            </li>
          );
        })}
      </ul>

      <p class="source-line"><a class="text-link" href="/kode-referral/">Lihat semua brand di direktori</a>.</p>
    </div>
  </section>
</BaseLayout>
