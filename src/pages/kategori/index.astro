---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../data/categories';
import { breadcrumbLd } from '../../data/site';
import { brandsInCategory, categoriesWithBrands, getBrands } from '../../lib/content';
import { categoryHref, indexableCategories } from '../../lib/policy';
import { categoryIndexOgCard } from '../../lib/og';

const brands = await getBrands();
const activeCategories = categoriesWithBrands(brands);
const origin = Astro.site ?? new URL('https://referralupdate.com');
const robots = indexableCategories(categories, brands).length > 0 ? 'index' : 'noindex';
const jsonLd = [
  breadcrumbLd(
    [
      { name: 'Beranda', path: '/' },
      { name: 'Kategori', path: '/kategori/' },
    ],
    origin,
  ),
  {
    '@type': 'CollectionPage',
    name: 'Kode referral per kategori',
    url: new URL('/kategori/', origin).toString(),
    inLanguage: 'id',
  },
];
---

<BaseLayout
  title="Kode referral per kategori"
  description="Cari kode referral berdasarkan kategori: e-wallet, bank digital, investasi, bisnis, dan hiburan. Lengkap dengan syarat dan tanggal cek."
  jsonLd={jsonLd}
  robots={robots}
  image={categoryIndexOgCard(brands)}
>
  <section class="page-head">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Beranda</a></li>
          <li>Kategori</li>
        </ol>
      </nav>
      <div class="page-head__body">
        <h1>Kode referral per kategori.</h1>
        <p class="lead">Pilih jenis layanan, lalu lihat kode, bonus, syarat, dan tanggal cek.</p>
      </div>
    </div>
  </section>

  <section class="categories">
    <div class="container">
      <ul class="index-list">
        {activeCategories.map((category) => {
          const count = brandsInCategory(brands, category.slug).length;
          return (
            <li class="index-row">
              <a href={categoryHref(category, brands)}>
                <span class="index-name">{category.name}</span>
                <span class="index-line">{category.line}</span>
                <span class="index-count">{count} brand</span>
              </a>
            </li>
          );
        })}
      </ul>

      <p class="source-line"><a class="text-link" href="/kode-referral/">Lihat semua brand di direktori</a>.</p>
    </div>
  </section>
</BaseLayout>
