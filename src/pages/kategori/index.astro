---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { categories } from '../../data/categories';
import { ui } from '../../data/copy';
import { homeCrumb, routes } from '../../data/routes';
import { breadcrumbLd, siteOrigin } from '../../data/site';
import { brandsInCategory, categoriesWithBrands, getBrands } from '../../lib/content';
import { categoryHref, indexableCategories } from '../../lib/policy';
import { categoryIndexOgCard } from '../../lib/og';

const brands = await getBrands();
const activeCategories = categoriesWithBrands(brands);
const origin = siteOrigin(Astro.site);
const robots = indexableCategories(categories, brands).length > 0 ? 'index' : 'noindex';
const jsonLd = [
  breadcrumbLd(
    [
      homeCrumb,
      { name: routes.categories.label, path: routes.categories.href },
    ],
    origin,
  ),
  {
    '@type': 'CollectionPage',
    name: 'Kode referral per kategori',
    url: new URL(routes.categories.href, origin).toString(),
    inLanguage: 'id',
  },
];
---

<BaseLayout
  title="Cari Kode Referral Berdasarkan Kategori"
  description="Cari kode referral berdasarkan kategori: e-wallet, bank digital, investasi, bisnis, dan hiburan. Lengkap dengan syarat dan tanggal cek."
  jsonLd={jsonLd}
  robots={robots}
  image={categoryIndexOgCard(brands)}
>
  <section class="page-head">
    <div class="container">
      <Breadcrumb
        items={[
          { label: routes.home.label, href: routes.home.href },
          { label: routes.categories.label },
        ]}
      />
      <div class="page-head__body">
        <h1>Kode referral per kategori.</h1>
        <p class="lead">Pilih jenis layanan, lalu lihat kode, bonus, syarat, dan tanggal cek.</p>
      </div>
    </div>
  </section>

  <section class="categories">
    <div class="container">
      <ul class="index-list">
        {activeCategories.map((category) => {
          const count = brandsInCategory(brands, category.slug).length;
          return (
            <li class="index-row">
              <a href={categoryHref(category, brands)}>
                <span class="index-name">{category.name}</span>
                <span class="index-line">{category.line}</span>
                <span class="index-count">{ui.brandCount(count)}</span>
              </a>
            </li>
          );
        })}
      </ul>

      <p class="source-line"><a class="text-link" href={routes.directory.href}>Lihat semua brand di direktori</a>.</p>
    </div>
  </section>
</BaseLayout>
