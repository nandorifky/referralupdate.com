---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BannerSlot from '../../components/BannerSlot.astro';
import BrandTable from '../../components/BrandTable.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCategories, type Category } from '../../data/categories';
import { homeCrumb, routes } from '../../data/routes';
import { breadcrumbLd, siteIds, siteOrigin } from '../../data/site';
import { brandsInCategory, getBrands, sortBrandsByChecked } from '../../lib/content';
import { isCategoryIndexable } from '../../lib/policy';
import { categoryOgCard } from '../../lib/og';

export async function getStaticPaths() {
  const brands = await getBrands();
  return getCategories()
    .filter((category) => isCategoryIndexable(category, brands))
    .map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props as { category: Category };
const brands = await getBrands();
const listed = sortBrandsByChecked(brandsInCategory(brands, category.slug));
const origin = siteOrigin(Astro.site);
const introParagraphs = category.intro.split(/\n\s*\n/).filter((paragraph) => paragraph.trim());
const pageUrl = new URL(`/kategori/${category.slug}/`, origin).toString();
const { website: websiteId, organization: organizationId } = siteIds(origin);
const webpageId = `${pageUrl}#webpage`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const itemListId = `${pageUrl}#itemlist`;

const jsonLd = [
  breadcrumbLd(
    [
      homeCrumb,
      { name: routes.categories.label, path: routes.categories.href },
      { name: category.name, path: `/kategori/${category.slug}/` },
    ],
    origin,
    breadcrumbId,
  ),
  {
    '@type': 'CollectionPage',
    '@id': webpageId,
    name: `Kode referral ${category.name}`,
    description: category.description,
    url: pageUrl,
    inLanguage: 'id',
    isPartOf: { '@id': websiteId },
    publisher: { '@id': organizationId },
    breadcrumb: { '@id': breadcrumbId },
    mainEntity: { '@id': itemListId },
  },
  {
    '@type': 'ItemList',
    '@id': itemListId,
    numberOfItems: listed.length,
    itemListElement: listed.map((brand, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `Kode referral ${brand.name}`,
      url: new URL(`/kode-referral/${brand.slug}/`, origin).toString(),
    })),
  },
];
---

<BaseLayout
  title={`Kode referral ${category.name}`}
  description={`${category.description} Lihat ${listed.length} kode referral dengan bonus, syarat, dan tanggal cek.`}
  jsonLd={jsonLd}
  robots="index"
  image={categoryOgCard(category, brands)}
>
  <section class="page-head">
    <div class="container">
      <Breadcrumb
        items={[
          { label: routes.home.label, href: routes.home.href },
          { label: routes.categories.label, href: routes.categories.href },
          { label: category.name },
        ]}
      />
      <div class="page-head__body">
        <h1>Kode referral {category.name}.</h1>
        <p class="lead">{category.description}</p>
      </div>
    </div>
  </section>

  <section class="ledger">
    <div class="container">
      <div class="category-intro">
        {introParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <BrandTable items={listed} caption={`Kode referral ${category.name}`} />

      <p class="source-line">
        {listed.length} brand, diurutkan dari yang paling baru dicek.{' '}
        <a class="text-link" href={routes.blog.href}>Baca panduan</a>.
      </p>

      <BannerSlot id="category-leaderboard" />
    </div>
  </section>
</BaseLayout>
