---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BannerSlot from '../../components/BannerSlot.astro';
import BrandGallery from '../../components/BrandGallery.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CodeCard from '../../components/CodeCard.astro';
import InlineText from '../../components/InlineText.astro';
import Toc from '../../components/Toc.astro';
import ResponsivePhoto from '../../components/ResponsivePhoto.astro';
import { getCategory } from '../../data/categories';
import { homeCrumb, routes } from '../../data/routes';
import { breadcrumbLd, formatIdDate, siteIds, siteOrigin } from '../../data/site';
import { brandsInCategory, getArticles, getBrands, sortArticlesByUpdated, type Article, type Brand } from '../../lib/content';
import { categoryHref, isBrandIndexable } from '../../lib/policy';
import { brandOgCard } from '../../lib/og';
import { paragraphsPlainText, parseInlineText, toParagraphs } from '../../lib/paragraphs';

export async function getStaticPaths() {
  const brands = await getBrands();
  return brands.map((brand) => ({ params: { brand: brand.slug }, props: { brand } }));
}

const { brand } = Astro.props as { brand: Brand };
const brands = await getBrands();
const articles = await getArticles();
const category = getCategory(brand.category)!;
const categoryPath = categoryHref(category, brands);
const robots = isBrandIndexable(brand) ? 'index' : 'noindex';
const origin = siteOrigin(Astro.site);
const pageUrl = new URL(`/kode-referral/${brand.slug}/`, origin).toString();
const { website: websiteId, organization: organizationId } = siteIds(origin);
const webpageId = `${pageUrl}#webpage`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const faqId = `${pageUrl}#faq`;
// Setiap gambar (sampul + galeri) dibuat versi yang tidak lebih besar dari
// berkas aslinya, lalu dideskripsikan sebagai ImageObject: URL stabil untuk
// JSON-LD dan mengikuti dimensi asli, sehingga Google membaca gambar dengan
// benar tanpa upscale.
const scaled = (src: { width: number; height: number }) => {
  const width = Math.min(1280, src.width);
  return { width, height: Math.round((src.height / src.width) * width) };
};
const photoObjects = await Promise.all(
  [brand.image, ...brand.gallery].map(async (photo) => {
    const dims = scaled(photo.src);
    const generated = await getImage({
      src: photo.src,
      width: dims.width,
      format: 'jpg',
      quality: 80,
    });
    return {
      '@type': 'ImageObject',
      contentUrl: new URL(generated.src, origin).toString(),
      caption: photo.caption,
      width: dims.width,
      height: dims.height,
    };
  }),
);
const siblings = brandsInCategory(brands, brand.category).filter((item) => item.slug !== brand.slug).slice(0, 4);
const relatedArticles = articles.filter((article) => article.relatedBrands.includes(brand.slug));
// Pilihan editor pada berkas brand menentukan tiga panduan di aside. Bila daftarnya kosong,
// perilaku lama dipakai sebagai cadangan supaya aside tidak pernah tampil kosong.
const curatedArticles = brand.relatedArticles
  .map((slug) => articles.find((article) => article.slug === slug))
  .filter((article): article is Article => Boolean(article));
const asideArticles = curatedArticles.length
  ? curatedArticles.slice(0, 3)
  : sortArticlesByUpdated(relatedArticles.length ? relatedArticles : articles).slice(0, 3);
const latestLog = brand.updateLog[0];
const refereeReward =
  brand.rewardReferee ?? 'Halaman resmi tidak mencantumkan bonus untuk pendaftar.';
const referrerReward =
  brand.rewardReferrer ?? 'Halaman resmi tidak mencantumkan komisi untuk pengundang.';
// Paragraf dipisah pada baris kosong, lalu tiap paragraf dipecah lagi menjadi
// potongan teks dan tautan, sehingga field YAML bisa ditulis sebagai beberapa
// paragraf sekaligus memuat tautan internal maupun eksternal.
const prose = (text: string) => toParagraphs(text).map(parseInlineText);
const summaryParagraphs = prose(brand.summary);
const payoutParagraphs = prose(brand.payoutNote);
const verificationParagraphs = prose(brand.verificationNote);
const refereeParagraphs = prose(refereeReward);
const referrerParagraphs = prose(referrerReward);
// Jawaban FAQ dan catatan riwayat juga berupa kalimat penjelas, jadi keduanya
// boleh ditulis sebagai beberapa paragraf. Versi teks polos dipakai JSON-LD
// supaya structured data tidak memuat markup tautan.
const faqParagraphs = brand.faqs.map((faq) => ({
  q: faq.q,
  paragraphs: prose(faq.a),
  plain: paragraphsPlainText(faq.a),
}));
const logParagraphs = brand.updateLog.map((entry) => ({
  date: entry.date,
  paragraphs: prose(entry.note),
}));

const toc = [
  { href: '#bonus', label: `Bonus referral ${brand.name} untuk pendaftar dan pengundang` },
  { href: '#cara-pakai', label: `Cara menggunakan kode referral ${brand.name}` },
  { href: '#syarat', label: 'Syarat untuk mendapat bonus' },
  { href: '#kapan-cair', label: 'Kapan bonus cair dan masa berlaku' },
  { href: '#syarat-lengkap', label: 'Syarat lengkap program' },
  ...(brand.gallery.length > 0
    ? [{ href: '#galeri', label: 'Gambar pendukung' }]
    : []),
  { href: '#sumber', label: 'Sumber dan cara pengecekan' },
  { href: '#faq', label: `Pertanyaan umum kode referral ${brand.name}` },
  { href: '#riwayat', label: 'Riwayat pengecekan' },
];

const validity = (() => {
  if (brand.validFrom && brand.expiresAt) {
    const period = `Berlaku ${formatIdDate(brand.validFrom)} sampai ${formatIdDate(brand.expiresAt)}.`;
    return brand.status === 'expired'
      ? `${period} Program berakhir dan tidak ada perpanjangan yang tercantum.`
      : period;
  }
  if (brand.expiresAt) {
    return `Program ini akan berakhir pada ${formatIdDate(brand.expiresAt)}.`;
  }
  if (brand.validFrom) {
    return `Berlaku sejak ${formatIdDate(brand.validFrom)}, Terakhir dicek pada ${formatIdDate(brand.checkedAt)}, dan masih valid hingga saat ini.`;
  }
  return `Kami akan selalu memperbarui informasi ini. Selama halaman ini bisa diakses, artinya informasi ini masih valid. Terakhir dicek pada ${formatIdDate(brand.checkedAt)}.`;
})();

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': webpageId,
    name: brand.seo.h1,
    url: pageUrl,
    description: brand.seo.description,
    image: photoObjects,
    primaryImageOfPage: photoObjects[0],
    inLanguage: 'id',
    dateModified: brand.checkedAt,
    isPartOf: { '@id': websiteId },
    publisher: { '@id': organizationId },
    breadcrumb: { '@id': breadcrumbId },
    author: {
      '@type': 'Person',
      name: brand.author.name,
      jobTitle: brand.author.role,
    },
    mainEntity: { '@id': faqId },
  },
  breadcrumbLd(
    [
      homeCrumb,
      { name: routes.directory.ldLabel ?? routes.directory.label, path: routes.directory.href },
      { name: category.name, path: categoryPath },
      { name: `Kode referral ${brand.name}`, path: `/kode-referral/${brand.slug}/` },
    ],
    origin,
    breadcrumbId,
  ),
  {
    '@type': 'FAQPage',
    '@id': faqId,
    isPartOf: { '@id': websiteId },
    mainEntity: faqParagraphs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.plain },
    })),
  },
];
---

<BaseLayout
  title={brand.seo.title}
  description={brand.seo.description}
  robots={robots}
  image={brandOgCard(brand)}
  jsonLd={jsonLd}
>
  <article>
  <section class="brand-head">
    <div class="container">
      <Breadcrumb
        items={[
          { label: routes.home.label, href: routes.home.href },
          { label: routes.directory.label, href: routes.directory.href },
          { label: category.name, href: categoryPath },
          { label: brand.name },
        ]}
      />
      <div class="brand-head__grid">
        <div class="brand-head__copy">
          <h1>{brand.seo.h1}</h1>
          {summaryParagraphs.map((paragraph) => (
            <p class="lead"><InlineText parts={paragraph} /></p>
          ))}
          <p class="brand-head__meta">
            Dicek <time datetime={brand.checkedAt}>{formatIdDate(brand.checkedAt)}</time> oleh{' '}
            {brand.author.name}.
          </p>
          <p class="brand-head__links">
            <a class="text-link" href={brand.officialUrl} rel="noopener noreferrer" target="_blank">Situs resmi {brand.name}</a>
            {brand.programUrl && brand.programUrl !== brand.officialUrl && (
              <a class="text-link" href={brand.programUrl} rel="noopener noreferrer" target="_blank">Halaman program</a>
            )}
          </p>
        </div>
        <CodeCard brand={brand} primary />
      </div>
    </div>
  </section>

  <section class="brand-cover">
    <div class="container">
      {brand.status === 'expired' && (
        <div class="brand-alert" role="note">
          <p>
            <strong>Program ini berakhir {brand.expiresAt ? formatIdDate(brand.expiresAt) : 'menurut sumber resmi'}.</strong>
            Kode {brand.code} tidak lagi dijamin aktif. Halaman ini tetap ada sampai ada program baru.
          </p>
        </div>
      )}
      <figure>
        <div class="slot slot--wide">
          <ResponsivePhoto
            photo={brand.image}
            sizes="(max-width: 40rem) calc(100vw - 2rem), (max-width: 60rem) calc(100vw - 3rem), (min-width: 90rem) 82rem, calc(100vw - 8rem)"
          />
        </div>
        <figcaption class="caption">{brand.image.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="brand-body">
    <div class="container brand-grid">
      <div class="brand-main">
        <Toc items={toc} />
        <section class="brand-section" aria-labelledby="bonus">
          <h2 id="bonus">Bonus referral {brand.name} untuk pengguna baru dan pengundang.</h2>
          <div class="reward-split">
            <div class="reward-split__item">
              <p class="reward-split__label">Untuk pendaftar</p>
              {refereeParagraphs.map((paragraph) => (
                <p class="reward-split__text"><InlineText parts={paragraph} /></p>
              ))}
            </div>
            <div class="reward-split__item">
              <p class="reward-split__label">Untuk pengundang</p>
              {referrerParagraphs.map((paragraph) => (
                <p class="reward-split__text"><InlineText parts={paragraph} /></p>
              ))}
            </div>
          </div>
          <p class="source-line">Bandingkan bonus pengundang di <a class="text-link" href={routes.programReferral.href}>informasi program referral terbaru</a>.</p>
        </section>

        <section class="brand-section" aria-labelledby="cara-pakai">
          <h2 id="cara-pakai">Cara pakai kode referral {brand.name}.</h2>
          <ol class="howto-list">
            {brand.steps.map((step) => <li><p>{step}</p></li>)}
          </ol>
        </section>

        <section class="brand-section" aria-labelledby="syarat">
          <h2 id="syarat">Syarat untuk mendapat bonus.</h2>
          <ul class="check-list">
            {brand.eligibility.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="brand-section" aria-labelledby="kapan-cair">
          <h2 id="kapan-cair">Kapan bonus cair dan masa berlaku.</h2>
          <dl class="fact-list">
            <div class="fact">
              <dt>Pencairan</dt>
              <dd>{payoutParagraphs.map((paragraph) => <p><InlineText parts={paragraph} /></p>)}</dd>
            </div>
            <div class="fact">
              <dt>Masa berlaku</dt>
              <dd>{validity}</dd>
            </div>
          </dl>
        </section>

        <section class="brand-section" aria-labelledby="syarat-lengkap">
          <h2 id="syarat-lengkap">Syarat & kententuan program referral {brand.name}.</h2>
          <ul class="terms-list">
            {brand.terms.map((term) => <li>{term}</li>)}
          </ul>
        </section>

        {brand.gallery.length > 0 && (
          <section class="brand-section" aria-labelledby="galeri">
            <h2 id="galeri">Gambar pendukung kode referral {brand.name}.</h2>
            <BrandGallery items={brand.gallery} />
          </section>
        )}

        <section class="brand-section" aria-labelledby="sumber">
          <h2 id="sumber">Sumber dan cara pengecekan.</h2>
          {verificationParagraphs.map((paragraph) => <p><InlineText parts={paragraph} /></p>)}
          <ul class="source-list">
            {brand.sources.map((source) => (
              <li>
                <a href={source.url} rel="noopener noreferrer" target="_blank">{source.label}</a>
              </li>
            ))}
          </ul>
          <p class="source-line">
            Dicek terakhir <time datetime={brand.checkedAt}>{formatIdDate(brand.checkedAt)}</time>{' '}
            oleh {brand.author.name}.
          </p>
        </section>

        <section class="brand-section" aria-labelledby="faq">
          <h2 id="faq">Pertanyaan umum terkait kode referral {brand.name}.</h2>
          <dl class="faq-list">
            {faqParagraphs.map((faq) => (
              <div class="faq-item">
                <dt>{faq.q}</dt>
                <dd>
                  {faq.paragraphs.length === 1
                    ? <InlineText parts={faq.paragraphs[0]} />
                    : faq.paragraphs.map((paragraph) => <p><InlineText parts={paragraph} /></p>)}
                </dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="brand-section" aria-labelledby="riwayat">
          <h2 id="riwayat">Riwayat pengecekan.</h2>
          <ul class="terms-list">
            {logParagraphs.map((entry) => (
              <li>
                <time datetime={entry.date}><strong>{formatIdDate(entry.date)}</strong></time>{' '}
                {entry.paragraphs.length === 1
                  ? <InlineText parts={entry.paragraphs[0]} />
                  : entry.paragraphs.map((paragraph) => <p><InlineText parts={paragraph} /></p>)}
              </li>
            ))}
          </ul>
          <p class="source-line">
            Pengecekan terakhir:{' '}
            <time datetime={latestLog.date}>{formatIdDate(latestLog.date)}</time>.{' '}
            <a class="text-link" href={routes.methodology.href}>Baca metodologi</a>.
          </p>
        </section>
      </div>

      <aside class="brand-aside" aria-label="Kode dan bacaan lain">
        <div class="aside-block">
          <p class="aside-title">Kode lain di {category.name}</p>
          <ul class="aside-list">
            {siblings.map((item) => (
              <li><a href={`/kode-referral/${item.slug}/`}>{item.name}</a></li>
            ))}
          </ul>
          <p class="aside-source"><a class="text-link" href={categoryPath}>Semua {category.name.toLowerCase()}</a></p>
        </div>

        <div class="aside-block">
          <p class="aside-title">Panduan terkait</p>
          <ul class="aside-list">
            {asideArticles.map((article) => (
              <li><a href={`/blog/${article.slug}/`}>{article.title}</a></li>
            ))}
          </ul>
        </div>

        <div class="aside-block">
          <p class="aside-source">Tautan referral di halaman ini bisa memberi komisi untuk pemilik kode. Bonus dan syarat bisa berubah; cek situs resmi sebelum mendaftar.</p>
        </div>

        <BannerSlot id="brand-rail" />
      </aside>
    </div>
  </section>
  </article>
</BaseLayout>
