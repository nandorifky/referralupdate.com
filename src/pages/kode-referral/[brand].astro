---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeCard from '../../components/CodeCard.astro';
import Toc from '../../components/Toc.astro';
import ResponsivePhoto from '../../components/ResponsivePhoto.astro';
import { getCategory } from '../../data/categories';
import { breadcrumbLd, formatIdDate } from '../../data/site';
import { brandsInCategory, getArticles, getBrands, type Brand } from '../../lib/content';
import { categoryHref, isBrandIndexable } from '../../lib/policy';
import { brandOgCard } from '../../lib/og';

export async function getStaticPaths() {
  const brands = await getBrands();
  return brands.map((brand) => ({ params: { brand: brand.slug }, props: { brand } }));
}

const { brand } = Astro.props as { brand: Brand };
const brands = await getBrands();
const articles = await getArticles();
const category = getCategory(brand.category)!;
const categoryPath = categoryHref(category, brands);
const robots = isBrandIndexable(brand) ? 'index' : 'noindex';
const origin = Astro.site ?? new URL('https://referralupdate.com');
const coverImage = await getImage({
  src: brand.image.src,
  width: 1280,
  format: 'jpg',
  quality: 80,
});
const siblings = brandsInCategory(brands, brand.category).filter((item) => item.slug !== brand.slug).slice(0, 4);
const relatedArticles = articles.filter((article) => article.relatedBrands.includes(brand.slug));
const asideArticles = (relatedArticles.length ? relatedArticles : articles).slice(0, 1);
const latestLog = brand.updateLog[0];
const refereeReward =
  brand.rewardReferee ?? 'Halaman resmi tidak mencantumkan bonus untuk pendaftar.';
const referrerReward =
  brand.rewardReferrer ?? 'Halaman resmi tidak mencantumkan komisi untuk pengundang.';

const toc = [
  { href: '#bonus', label: 'Bonus untuk pendaftar dan pengundang' },
  { href: '#cara-pakai', label: `Cara pakai kode referral ${brand.name}` },
  { href: '#syarat', label: 'Syarat untuk mendapat bonus' },
  { href: '#kapan-cair', label: 'Kapan bonus cair dan masa berlaku' },
  { href: '#syarat-lengkap', label: 'Syarat lengkap program' },
  { href: '#sumber', label: 'Sumber dan cara pengecekan' },
  { href: '#faq', label: `Pertanyaan umum kode referral ${brand.name}` },
  { href: '#riwayat', label: 'Riwayat pengecekan' },
];

const validity = (() => {
  if (brand.validFrom && brand.expiresAt) {
    const period = `Berlaku ${formatIdDate(brand.validFrom)} sampai ${formatIdDate(brand.expiresAt)}.`;
    return brand.status === 'expired'
      ? `${period} Program berakhir dan tidak ada perpanjangan yang tercantum.`
      : period;
  }
  if (brand.expiresAt) {
    return `Program ini akan berakhir pada ${formatIdDate(brand.expiresAt)}.`;
  }
  if (brand.validFrom) {
    return `Berlaku sejak ${formatIdDate(brand.validFrom)}, halaman resmi tidak mencantumkan tanggal berakhir. Terakhir dicek: ${formatIdDate(brand.checkedAt)}, dan masih valid hingga saat ini.`;
  }
  return `Halaman resmi tidak mencantumkan tanggal mulai maupun tanggal berakhir; status dicek ${formatIdDate(brand.checkedAt)}.`;
})();

const jsonLd = [
  {
    '@type': 'WebPage',
    name: brand.seo.h1,
    url: new URL(`/kode-referral/${brand.slug}/`, origin).toString(),
    description: brand.seo.description,
    image: new URL(coverImage.src, origin).toString(),
    inLanguage: 'id',
    dateModified: brand.checkedAt,
  },
  breadcrumbLd(
    [
      { name: 'Beranda', path: '/' },
      { name: 'Direktori kode referral', path: '/kode-referral/' },
      { name: `Kode referral ${brand.name}`, path: `/kode-referral/${brand.slug}/` },
    ],
    origin,
  ),
  {
    '@type': 'FAQPage',
    mainEntity: brand.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title={brand.seo.title}
  description={brand.seo.description}
  robots={robots}
  image={brandOgCard(brand)}
  jsonLd={jsonLd}
>
  <article>
  <section class="brand-head">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Beranda</a></li>
          <li><a href="/kode-referral/">Direktori</a></li>
          <li><a href={categoryPath}>{category.name}</a></li>
          <li>{brand.name}</li>
        </ol>
      </nav>
      <div class="brand-head__grid">
        <div class="brand-head__copy">
          <h1>{brand.seo.h1}</h1>
          <p class="lead">{brand.summary}</p>
          <p class="brand-head__meta">
            Dicek <time datetime={brand.checkedAt}>{formatIdDate(brand.checkedAt)}</time> oleh{' '}
            {brand.author.name}.
          </p>
          <p class="brand-head__links">
            <a class="text-link" href={brand.officialUrl} rel="noopener noreferrer" target="_blank">Situs resmi {brand.name}</a>
            {brand.programUrl && brand.programUrl !== brand.officialUrl && (
              <a class="text-link" href={brand.programUrl} rel="noopener noreferrer" target="_blank">Halaman program</a>
            )}
          </p>
        </div>
        <CodeCard brand={brand} primary />
      </div>
    </div>
  </section>

  <section class="brand-cover">
    <div class="container">
      {brand.status === 'expired' && (
        <div class="brand-alert" role="note">
          <p>
            <strong>Program ini berakhir {brand.expiresAt ? formatIdDate(brand.expiresAt) : 'menurut sumber resmi'}.</strong>
            Kode {brand.code} tidak lagi dijamin aktif. Halaman ini tetap ada sampai ada program baru.
          </p>
        </div>
      )}
      <figure>
        <div class="slot slot--wide">
          <ResponsivePhoto
            photo={brand.image}
            sizes="(max-width: 40rem) calc(100vw - 2rem), (max-width: 60rem) calc(100vw - 3rem), (min-width: 90rem) 82rem, calc(100vw - 8rem)"
          />
        </div>
        <figcaption class="caption">{brand.image.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="brand-body">
    <div class="container brand-grid">
      <div class="brand-main">
        <Toc items={toc} />
        <section class="brand-section" aria-labelledby="bonus">
          <h2 id="bonus">Bonus untuk pendaftar dan pengundang.</h2>
          <div class="reward-split">
            <div class="reward-split__item">
              <p class="reward-split__label">Untuk pendaftar</p>
              <p class="reward-split__text">{refereeReward}</p>
            </div>
            <div class="reward-split__item">
              <p class="reward-split__label">Untuk pengundang</p>
              <p class="reward-split__text">{referrerReward}</p>
            </div>
          </div>
        </section>

        <section class="brand-section" aria-labelledby="cara-pakai">
          <h2 id="cara-pakai">Cara pakai kode referral {brand.name}.</h2>
          <ol class="howto-list">
            {brand.steps.map((step) => <li><p>{step}</p></li>)}
          </ol>
        </section>

        <section class="brand-section" aria-labelledby="syarat">
          <h2 id="syarat">Syarat untuk mendapat bonus.</h2>
          <ul class="check-list">
            {brand.eligibility.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="brand-section" aria-labelledby="kapan-cair">
          <h2 id="kapan-cair">Kapan bonus cair dan masa berlaku.</h2>
          <dl class="fact-list">
            <div class="fact">
              <dt>Pencairan</dt>
              <dd>{brand.payoutNote}</dd>
            </div>
            <div class="fact">
              <dt>Masa berlaku</dt>
              <dd>{validity}</dd>
            </div>
          </dl>
        </section>

        <section class="brand-section" aria-labelledby="syarat-lengkap">
          <h2 id="syarat-lengkap">Syarat & kententuan program referral {brand.name}.</h2>
          <ul class="terms-list">
            {brand.terms.map((term) => <li>{term}</li>)}
          </ul>
        </section>

        <section class="brand-section" aria-labelledby="sumber">
          <h2 id="sumber">Sumber dan cara pengecekan.</h2>
          <p>{brand.verificationNote}</p>
          <ul class="source-list">
            {brand.sources.map((source) => (
              <li>
                <a href={source.url} rel="noopener noreferrer" target="_blank">{source.label}</a>
              </li>
            ))}
          </ul>
          <p class="source-line">
            Dicek terakhir <time datetime={brand.checkedAt}>{formatIdDate(brand.checkedAt)}</time>{' '}
            oleh {brand.author.name}.
          </p>
        </section>

        <section class="brand-section" aria-labelledby="faq">
          <h2 id="faq">Pertanyaan umum kode referral {brand.name}.</h2>
          <dl class="faq-list">
            {brand.faqs.map((faq) => (
              <div class="faq-item">
                <dt>{faq.q}</dt>
                <dd>{faq.a}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="brand-section" aria-labelledby="riwayat">
          <h2 id="riwayat">Riwayat pengecekan.</h2>
          <ul class="terms-list">
            {brand.updateLog.map((entry) => (
              <li>
                <time datetime={entry.date}><strong>{formatIdDate(entry.date)}</strong></time>{' '}
                {entry.note}
              </li>
            ))}
          </ul>
          <p class="source-line">
            Pengecekan terakhir:{' '}
            <time datetime={latestLog.date}>{formatIdDate(latestLog.date)}</time>.{' '}
            <a class="text-link" href="/metodologi-verifikasi/">Baca metodologi</a>.
          </p>
        </section>
      </div>

      <aside class="brand-aside" aria-label="Kode dan bacaan lain">
        <div class="aside-block">
          <p class="aside-title">Kode lain di {category.name}</p>
          <ul class="aside-list">
            {siblings.map((item) => (
              <li><a href={`/kode-referral/${item.slug}/`}>{item.name}</a></li>
            ))}
          </ul>
          <p class="aside-source"><a class="text-link" href={categoryPath}>Semua {category.name.toLowerCase()}</a></p>
        </div>

        <div class="aside-block">
          <p class="aside-title">Panduan terkait</p>
          <ul class="aside-list">
            {asideArticles.map((article) => (
              <li><a href={`/blog/${article.slug}/`}>{article.title}</a></li>
            ))}
          </ul>
        </div>

        <div class="aside-block">
          <p class="aside-source">Tautan referral di halaman ini bisa memberi komisi untuk pemilik kode. Bonus dan syarat bisa berubah; cek situs resmi sebelum mendaftar.</p>
        </div>
      </aside>
    </div>
  </section>
  </article>
</BaseLayout>
