---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeCard from '../../components/CodeCard.astro';
import {
  articles,
  brands,
  brandsByCategory,
  getCategory,
  breadcrumbLd,
  type Brand,
} from '../../data/site';

export function getStaticPaths() {
  return brands.map((brand) => ({ params: { brand: brand.slug }, props: { brand } }));
}

const { brand } = Astro.props as { brand: Brand };
const category = getCategory(brand.category)!;
const origin = Astro.site ?? new URL('https://kode-referral.example');
const lowerReward = brand.reward.charAt(0).toLowerCase() + brand.reward.slice(1);
const siblings = brandsByCategory(brand.category).filter((item) => item.slug !== brand.slug).slice(0, 4);
const relatedArticles = articles.filter((article) => article.relatedBrands.includes(brand.slug));
const asideArticles = (relatedArticles.length ? relatedArticles : articles).slice(0, 1);

const jsonLd = [
  breadcrumbLd(
    [
      { name: 'Beranda', path: '/' },
      { name: 'Direktori kode referral', path: '/kode-referral/' },
      { name: `Kode referral ${brand.name}`, path: `/kode-referral/${brand.slug}/` },
    ],
    origin,
  ),
  {
    '@type': 'FAQPage',
    mainEntity: brand.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title={`Kode referral ${brand.name}`}
  description={`Kode referral ${brand.name} dengan ${lowerReward}. Lihat cara pakai, syarat, dan tanggal cek terakhir sebelum mendaftar.`}
  jsonLd={jsonLd}
>
  <div class="container">
    <div class="brand-hero">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Beranda</a></li>
          <li><a href="/kode-referral/">Direktori</a></li>
          <li><a href={`/kategori/${category.slug}/`}>{category.name}</a></li>
          <li>{brand.name}</li>
        </ol>
      </nav>
      <div class="brand-hero__inner">
        <div class="brand-hero__copy">
          <div>
            <h1>Kode referral {brand.name}.</h1>
            <p class="lead">Dicek {brand.checked}. Syarat dan langkah bisa dibaca.</p>
          </div>
          <a class="text-link" href={brand.officialUrl} rel="sponsored nofollow noopener noreferrer" target="_blank">Kunjungi situs resmi</a>
        </div>
        <figure class="brand-hero__visual">
          <CodeCard brand={brand} primary />
          <figcaption class="disclosure-note">Pratinjau desain. Kode dan tanggal di kartu ini adalah data contoh.</figcaption>
        </figure>
      </div>
    </div>

    <div class="brand-body">
      <div class="brand-grid">
        <div>
          <section class="brand-section">
            <h2>Isi kode {brand.code} saat daftar.</h2>
            <ol class="howto-list">
              {brand.steps.map((step) => <li><p>{step}</p></li>)}
            </ol>
          </section>

          <section class="brand-section">
            <h2>Syarat agar {lowerReward} masuk.</h2>
            <ul class="terms-list">
              {brand.terms.map((term) => <li>{term}</li>)}
            </ul>
          </section>

          <section class="brand-section">
            <h2>Pertanyaan soal kode {brand.name}.</h2>
            <dl class="faq-list">
              {brand.faqs.map((faq) => (
                <div class="faq-item">
                  <dt>{faq.q}</dt>
                  <dd>{faq.a}</dd>
                </div>
              ))}
            </dl>
          </section>

          <p class="editor-note">
            Dicek tim editorial KodeReferral. <a href="/metodologi-verifikasi/">Baca metodologi</a>.
          </p>
        </div>

        <aside class="brand-aside" aria-label="Kode dan bacaan lain">
          <div class="aside-block">
            <p class="aside-title">Kode lain di {category.name}</p>
            <ul class="aside-list">
              {siblings.map((item) => (
                <li><a href={`/kode-referral/${item.slug}/`}>{item.name}</a></li>
              ))}
            </ul>
            <p class="source-line"><a class="text-link" href={`/kategori/${category.slug}/`}>Semua {category.name.toLowerCase()}</a></p>
          </div>

          <div class="aside-block">
            <p class="aside-title">Bacaan</p>
            <ul class="aside-list">
              {asideArticles.map((article) => (
                <li><a href={`/blog/${article.slug}/`}>{article.title}</a></li>
              ))}
            </ul>
          </div>

          <div class="aside-block">
            <p class="source-line">Bisa memuat tautan affiliate.</p>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>
