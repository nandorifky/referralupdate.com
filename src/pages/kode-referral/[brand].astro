---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeCard from '../../components/CodeCard.astro';
import { getCategory } from '../../data/categories';
import { breadcrumbLd, brandPhotos, formatIdDate } from '../../data/site';
import { brandsInCategory, getArticles, getBrands, type Brand } from '../../lib/content';
import { categoryHref, isBrandIndexable } from '../../lib/policy';

export async function getStaticPaths() {
  const brands = await getBrands();
  return brands.map((brand) => ({ params: { brand: brand.slug }, props: { brand } }));
}

const { brand } = Astro.props as { brand: Brand };
const brands = await getBrands();
const articles = await getArticles();
const category = getCategory(brand.category)!;
const categoryPhoto = brandPhotos[brand.category];
const categoryPath = categoryHref(category, brands);
const robots = isBrandIndexable(brand) ? 'index' : 'noindex';
const origin = Astro.site ?? new URL('https://kode-referral.example');
const siblings = brandsInCategory(brands, brand.category).filter((item) => item.slug !== brand.slug).slice(0, 4);
const relatedArticles = articles.filter((article) => article.relatedBrands.includes(brand.slug));
const asideArticles = (relatedArticles.length ? relatedArticles : articles).slice(0, 1);
const latestLog = brand.updateLog[0];
const refereeReward =
  brand.rewardReferee ?? 'Halaman resmi tidak mencantumkan bonus untuk pendaftar.';
const referrerReward =
  brand.rewardReferrer ?? 'Halaman resmi tidak mencantumkan komisi untuk pengundang.';

function clamp(text: string, max = 158) {
  if (text.length <= max) return text;
  const cut = text.slice(0, max - 1);
  const at = cut.lastIndexOf(' ');
  return `${cut.slice(0, at > 0 ? at : cut.length)}…`;
}

const statusLead = {
  active: `Kode referral ${brand.name} aktif menurut sumber resmi.`,
  unverified: `Kode referral ${brand.name} belum terverifikasi.`,
  expired: `Kode referral ${brand.name} berakhir ${brand.expiresAt ? formatIdDate(brand.expiresAt) : 'menurut sumber resmi'}.`,
}[brand.status];
const description = clamp(`${statusLead} ${refereeReward}`);

const validity = (() => {
  if (brand.validFrom && brand.expiresAt) {
    const period = `Berlaku ${formatIdDate(brand.validFrom)} sampai ${formatIdDate(brand.expiresAt)}.`;
    return brand.status === 'expired'
      ? `${period} Program berakhir dan tidak ada perpanjangan yang tercantum.`
      : period;
  }
  if (brand.expiresAt) {
    return `Berakhir ${formatIdDate(brand.expiresAt)}.`;
  }
  return `Halaman resmi tidak mencantumkan tanggal mulai atau berakhir; status dicek ${formatIdDate(brand.checkedAt)}.`;
})();

const jsonLd = [
  {
    '@type': 'WebPage',
    name: `Kode referral ${brand.name}`,
    url: new URL(`/kode-referral/${brand.slug}/`, origin).toString(),
    description,
    inLanguage: 'id',
    dateModified: brand.checkedAt,
  },
  breadcrumbLd(
    [
      { name: 'Beranda', path: '/' },
      { name: 'Direktori kode referral', path: '/kode-referral/' },
      { name: `Kode referral ${brand.name}`, path: `/kode-referral/${brand.slug}/` },
    ],
    origin,
  ),
  {
    '@type': 'FAQPage',
    mainEntity: brand.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title={`Kode referral ${brand.name}`}
  description={description}
  robots={robots}
  jsonLd={jsonLd}
>
  <section class="brand-head">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Beranda</a></li>
          <li><a href="/kode-referral/">Direktori</a></li>
          <li><a href={categoryPath}>{category.name}</a></li>
          <li>{brand.name}</li>
        </ol>
      </nav>
      <div class="brand-head__grid">
        <div class="brand-head__copy">
          <h1>Kode referral {brand.name}.</h1>
          <p class="lead">{brand.summary}</p>
          <p class="brand-head__meta">Program dicek {formatIdDate(brand.checkedAt)}. Dicatat oleh {brand.author.name}, {brand.author.role}.</p>
          <p class="brand-head__links">
            <a class="text-link" href={brand.officialUrl} rel="noopener noreferrer" target="_blank">Situs resmi {brand.name}</a>
            {brand.programUrl && brand.programUrl !== brand.officialUrl && (
              <a class="text-link" href={brand.programUrl} rel="noopener noreferrer" target="_blank">Halaman program</a>
            )}
          </p>
        </div>
        <CodeCard brand={brand} primary />
      </div>
    </div>
  </section>

  <section class="brand-cover">
    <div class="container">
      {brand.status === 'expired' && (
        <div class="brand-alert" role="note">
          <p>
            <strong>Program ini berakhir {brand.expiresAt ? formatIdDate(brand.expiresAt) : 'menurut sumber resmi'}.</strong>
            Kode {brand.code} tidak lagi dijanjikan berlaku. Halaman dipertahankan sebagai catatan sampai statusnya berubah.
          </p>
        </div>
      )}
      <figure>
        <div class="slot slot--wide" data-slot={`brand-${brand.category}`} data-alt={categoryPhoto.alt}>
          <img
            src={categoryPhoto.src}
            alt={categoryPhoto.alt}
            width="1920"
            height="1280"
            style={`object-position: ${categoryPhoto.position}`}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="caption">Foto ilustrasi kategori {category.name}. Bukan tangkapan layar resmi {brand.name}.</figcaption>
      </figure>
    </div>
  </section>

  <section class="brand-body">
    <div class="container brand-grid">
      <div class="brand-main">
        <section class="brand-section">
          <h2>Bonus untuk siapa.</h2>
          <div class="reward-split">
            <div class="reward-split__item">
              <p class="reward-split__label">Untuk pendaftar</p>
              <p class="reward-split__text">{refereeReward}</p>
            </div>
            <div class="reward-split__item">
              <p class="reward-split__label">Untuk pengundang</p>
              <p class="reward-split__text">{referrerReward}</p>
            </div>
          </div>
        </section>

        <section class="brand-section">
          <h2>Isi kode {brand.code} saat daftar.</h2>
          <ol class="howto-list">
            {brand.steps.map((step) => <li><p>{step}</p></li>)}
          </ol>
        </section>

        <section class="brand-section">
          <h2>Syarat utama.</h2>
          <ul class="check-list">
            {brand.eligibility.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="brand-section">
          <h2>Pencairan dan masa berlaku.</h2>
          <dl class="fact-list">
            <div class="fact">
              <dt>Pencairan</dt>
              <dd>{brand.payoutNote}</dd>
            </div>
            <div class="fact">
              <dt>Masa berlaku</dt>
              <dd>{validity}</dd>
            </div>
          </dl>
        </section>

        <section class="brand-section">
          <h2>Syarat rinci program.</h2>
          <ul class="terms-list">
            {brand.terms.map((term) => <li>{term}</li>)}
          </ul>
        </section>

        <section class="brand-section">
          <h2>Bagaimana kode ini dicek.</h2>
          <p>{brand.verificationNote}</p>
          <ul class="source-list">
            {brand.sources.map((source) => (
              <li>
                <a href={source.url} rel="noopener noreferrer" target="_blank">{source.label}</a>
              </li>
            ))}
          </ul>
          <p class="source-line">Program dicek terakhir {formatIdDate(brand.checkedAt)} oleh {brand.author.name}.</p>
        </section>

        <section class="brand-section">
          <h2>Pertanyaan soal kode {brand.name}.</h2>
          <dl class="faq-list">
            {brand.faqs.map((faq) => (
              <div class="faq-item">
                <dt>{faq.q}</dt>
                <dd>{faq.a}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="brand-section">
          <h2>Riwayat pengecekan.</h2>
          <ul class="terms-list">
            {brand.updateLog.map((entry) => (
              <li>
                <strong>{formatIdDate(entry.date)}</strong> {entry.note}
              </li>
            ))}
          </ul>
          <p class="source-line">Catatan terbaru: {formatIdDate(latestLog.date)}. <a class="text-link" href="/metodologi-verifikasi/">Baca metodologi</a>.</p>
        </section>
      </div>

      <aside class="brand-aside" aria-label="Kode dan bacaan lain">
        <div class="aside-block">
          <p class="aside-title">Kode lain di {category.name}</p>
          <ul class="aside-list">
            {siblings.map((item) => (
              <li><a href={`/kode-referral/${item.slug}/`}>{item.name}</a></li>
            ))}
          </ul>
          <p class="aside-source"><a class="text-link" href={categoryPath}>Semua {category.name.toLowerCase()}</a></p>
        </div>

        <div class="aside-block">
          <p class="aside-title">Bacaan</p>
          <ul class="aside-list">
            {asideArticles.map((article) => (
              <li><a href={`/blog/${article.slug}/`}>{article.title}</a></li>
            ))}
          </ul>
        </div>

        <div class="aside-block">
          <p class="aside-source">Tautan referral di halaman ini diberi label dan dapat memberi manfaat bagi pemilik kode. Bonus bisa berubah tanpa pemberitahuan; situs resmi tetap acuan.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
