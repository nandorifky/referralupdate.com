---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandTable from '../../components/BrandTable.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { ui } from '../../data/copy';
import { homeCrumb, routes } from '../../data/routes';
import { breadcrumbLd, siteOrigin } from '../../data/site';
import { categoriesWithBrands, getBrands, sortBrandsByChecked } from '../../lib/content';
import { isDirectoryIndexable } from '../../lib/policy';
import { directoryOgCard } from '../../lib/og';

const brands = await getBrands();
const activeCategories = categoriesWithBrands(brands);
const origin = siteOrigin(Astro.site);
const listed = sortBrandsByChecked(brands);
const robots = isDirectoryIndexable(brands) ? 'index' : 'noindex';

const jsonLd = [
  breadcrumbLd(
    [
      homeCrumb,
      { name: routes.directory.ldLabel ?? routes.directory.label, path: routes.directory.href },
    ],
    origin,
  ),
  {
    '@type': 'CollectionPage',
    name: 'Direktori kode referral Indonesia',
    description: 'Daftar kode referral untuk e-wallet, bank digital, investasi, layanan bisnis, dan hiburan.',
    url: new URL(routes.directory.href, origin).toString(),
    inLanguage: 'id',
  },
  {
    '@type': 'ItemList',
    numberOfItems: listed.length,
    itemListElement: listed.map((brand, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `Kode referral ${brand.name}`,
      url: new URL(`/kode-referral/${brand.slug}/`, origin).toString(),
    })),
  },
];
---

<BaseLayout
  title="Daftar kode referral Indonesia"
  description="Cari kode referral aplikasi dan layanan digital di Indonesia. Lihat bonus, syarat, status, dan tanggal cek terbaru."
  jsonLd={jsonLd}
  robots={robots}
  image={directoryOgCard(brands)}
>
  <section class="page-head">
    <div class="container">
      <Breadcrumb
        items={[
          { label: routes.home.label, href: routes.home.href },
          { label: routes.directory.label },
        ]}
      />
      <div class="page-head__body">
        <h1>Daftar kode referral Indonesia.</h1>
        <p class="lead">{brands.length} brand aplikasi dan layanan digital di {activeCategories.length} kategori, lengkap dengan bonus, syarat, dan tanggal cek.</p>
      </div>
    </div>
  </section>

  <section class="field filter-band">
    <div class="container">
      <form class="filter" method="get" action={routes.directory.href} data-filter role="search">
        <div class="filter__field">
          <label for="directory-q">Cari brand</label>
          <input id="directory-q" name="q" type="search" placeholder={ui.brandExamples} autocomplete="off" spellcheck="false" />
        </div>
        <div class="filter__field">
          <label for="directory-category">Kategori</label>
          <select id="directory-category" name="kategori">
            <option value="">Semua kategori</option>
            {activeCategories.map((category) => <option value={category.slug}>{category.name}</option>)}
          </select>
        </div>
        <button class="btn" type="submit">Tampilkan</button>
        <p class="filter__count" data-filter-count aria-live="polite">{ui.brandCount(brands.length)}</p>
      </form>
    </div>
  </section>

  <section class="ledger">
    <div class="container">
      <p class="filter__empty" data-filter-empty hidden>Tidak ada brand yang cocok. Coba kata kunci lain atau pilih semua kategori.</p>

      <BrandTable items={listed} caption="Semua brand dengan kode referral di direktori" />

      <p class="source-line">Tanggal cek diperbarui saat halaman program dicek ulang. <a class="text-link" href={routes.methodology.href}>Baca cara pengecekan</a>.</p>
    </div>
  </section>
</BaseLayout>
