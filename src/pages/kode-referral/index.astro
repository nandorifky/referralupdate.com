---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandTable from '../../components/BrandTable.astro';
import { brands, brandsByChecked, categories, breadcrumbLd } from '../../data/site';

const origin = Astro.site ?? new URL('https://kode-referral.example');
const listed = brandsByChecked();

const jsonLd = [
  breadcrumbLd(
    [
      { name: 'Beranda', path: '/' },
      { name: 'Direktori kode referral', path: '/kode-referral/' },
    ],
    origin,
  ),
  {
    '@type': 'CollectionPage',
    name: 'Direktori kode referral Indonesia',
    description: 'Daftar kode referral untuk e-wallet, bank digital, investasi, e-commerce, travel, food delivery, dan SaaS.',
    url: new URL('/kode-referral/', origin).toString(),
    inLanguage: 'id',
  },
  {
    '@type': 'ItemList',
    numberOfItems: listed.length,
    itemListElement: listed.map((brand, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `Kode referral ${brand.name}`,
      url: new URL(`/kode-referral/${brand.slug}/`, origin).toString(),
    })),
  },
];
---

<BaseLayout
  title="Direktori kode referral"
  description="Daftar kode referral Indonesia dengan tanggal cek terakhir, bonus, dan syarat. Filter berdasarkan nama brand atau kategori."
  jsonLd={jsonLd}
>
  <div class="container">
    <section class="index-head index-head--wide">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Beranda</a></li>
          <li>Direktori</li>
        </ol>
      </nav>
      <div class="index-head__body">
        <h1>Direktori kode referral.</h1>
        <p class="lead">{brands.length} brand di {categories.length} kategori, semuanya dengan tanggal cek terakhir.</p>
        <form class="filter" method="get" action="/kode-referral/" data-filter role="search">
          <div class="filter__field">
            <label for="directory-q">Cari brand</label>
            <input id="directory-q" name="q" type="search" placeholder="Bibit, GoPay, Jago" autocomplete="off" spellcheck="false" />
          </div>
          <div class="filter__field">
            <label for="directory-category">Kategori</label>
            <select id="directory-category" name="kategori">
              <option value="">Semua kategori</option>
              {categories.map((category) => <option value={category.slug}>{category.name}</option>)}
            </select>
          </div>
          <button class="btn btn--ink" type="submit">Terapkan</button>
          <p class="filter__count" data-filter-count aria-live="polite">{brands.length} brand</p>
        </form>
      </div>
    </section>

    <p class="filter__empty" data-filter-empty hidden>Tidak ada brand yang cocok. Coba kata kunci lain atau pilih semua kategori.</p>

    <BrandTable items={listed} caption="Semua brand dengan kode referral di direktori" />

    <p class="source-line">Tanggal cek diperbarui saat kode ditinjau ulang. <a class="text-link" href="/metodologi-verifikasi/">Baca metodologinya</a>.</p>
  </div>
</BaseLayout>
