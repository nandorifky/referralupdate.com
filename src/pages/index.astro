---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeProcess from '../components/home/HomeProcess.astro';
import HomeChecks from '../components/home/HomeChecks.astro';
import HomeLedger from '../components/home/HomeLedger.astro';
import HomeCategories from '../components/home/HomeCategories.astro';
import HomeNotes from '../components/home/HomeNotes.astro';
import HomeClosing from '../components/home/HomeClosing.astro';
import { homeLedger, homeMeta, homeStructuredData } from '../data/home';
import { site, siteOrigin } from '../data/site';
import {
  categoriesWithBrands,
  getArticles,
  getBrands,
  sortArticlesByUpdated,
  sortBrandsByChecked,
} from '../lib/content';
import { isDirectoryIndexable } from '../lib/policy';
import { homeOgCard } from '../lib/og';

const brands = await getBrands();
const articles = await getArticles();
const sorted = sortBrandsByChecked(brands);
const activeBrands = sorted.filter((brand) => brand.status === 'active');
const latest = activeBrands[0] ?? sorted[0];
const ledgerBrands = activeBrands.slice(0, homeLedger.limit);
const activeCategories = categoriesWithBrands(brands);
const sortedArticles = sortArticlesByUpdated(articles);
const robots = isDirectoryIndexable(brands) ? 'index' : 'noindex';
const origin = siteOrigin(Astro.site);

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: homeStructuredData.collectionPageName,
    url: new URL('/', origin).toString(),
    inLanguage: 'id',
    isPartOf: { '@type': 'WebSite', name: site.name, url: new URL('/', origin).toString() },
  },
  {
    '@type': 'ItemList',
    name: homeStructuredData.itemListName,
    numberOfItems: ledgerBrands.length,
    itemListElement: ledgerBrands.map((brand, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: homeStructuredData.itemName(brand.name),
      url: new URL(`/kode-referral/${brand.slug}/`, origin).toString(),
    })),
  },
];
---

<BaseLayout
  title={homeMeta.title}
  description={homeMeta.description}
  jsonLd={jsonLd}
  robots={robots}
  image={homeOgCard(brands)}
>
  <HomeHero
    latest={latest}
    activeCount={activeBrands.length}
    totalCount={brands.length}
    categoryCount={activeCategories.length}
  />
  <HomeProcess />
  <HomeChecks />
  <HomeLedger items={ledgerBrands} />
  <HomeCategories categories={activeCategories} brands={brands} />
  <HomeNotes articles={sortedArticles} />
  <HomeClosing />
</BaseLayout>
