---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchForm from '../components/SearchForm.astro';
import BrandTable from '../components/BrandTable.astro';
import ResponsivePhoto from '../components/ResponsivePhoto.astro';
import { blogCategoryName } from '../data/blog-categories';
import { formatIdDate, photos, site } from '../data/site';
import {
  brandsInCategory,
  categoriesWithBrands,
  getArticles,
  getBrands,
  sortArticlesByUpdated,
  sortBrandsByChecked,
} from '../lib/content';
import { categoryHref, isDirectoryIndexable } from '../lib/policy';
import { homeOgCard } from '../lib/og';

const brands = await getBrands();
const articles = await getArticles();
const sorted = sortBrandsByChecked(brands);
const activeBrands = sorted.filter((brand) => brand.status === 'active');
const latest = activeBrands[0] ?? sorted[0];
const ledgerBrands = activeBrands.slice(0, 4);
const activeCategories = categoriesWithBrands(brands);
const sortedArticles = sortArticlesByUpdated(articles);
const featuredArticle = sortedArticles[0];
const moreArticles = sortedArticles.slice(1);
const robots = isDirectoryIndexable(brands) ? 'index' : 'noindex';
const origin = Astro.site ?? new URL('https://referralupdate.com');
const heroSizes = '(max-width: 60rem) 92vw, 32vw';
const heroPreload = await getImage({
  src: photos.hero.src,
  widths: [640, 960, 1280, 1920],
  format: 'avif',
  quality: 68,
});

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Kode referral aktif di Indonesia',
    url: new URL('/', origin).toString(),
    inLanguage: 'id',
    isPartOf: { '@type': 'WebSite', name: site.name, url: new URL('/', origin).toString() },
  },
  {
    '@type': 'ItemList',
    name: 'Kode referral aktif dengan tanggal cek',
    numberOfItems: ledgerBrands.length,
    itemListElement: ledgerBrands.map((brand, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `Kode referral ${brand.name}`,
      url: new URL(`/kode-referral/${brand.slug}/`, origin).toString(),
    })),
  },
];
---

<BaseLayout
  title="Kode referral aktif di Indonesia"
  description="Brand aktif dengan kode referral dan tanggal ceknya. Lihat bonus, syarat, dan status sebelum mendaftar, lalu buka direktori untuk semua brand."
  jsonLd={jsonLd}
  robots={robots}
  image={homeOgCard(brands)}
  preloadImage={{
    href: heroPreload.src,
    srcset: heroPreload.srcSet.attribute,
    sizes: heroSizes,
  }}
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1>Kode referral aktif di Indonesia.</h1>
        <p class="hero__lead">Kode, bonus, syarat, dan tanggal cek dalam satu tempat.</p>
        <SearchForm id="hero-search" />
        <p class="hero__facts">{activeBrands.length} dari {brands.length} brand berstatus aktif di {activeCategories.length} kategori.</p>
        <p class="hero__links">
          <a class="text-link" href="/kode-referral/">Lihat semua kode referral</a>
          <a class="text-link" href="/metodologi-verifikasi/">Cara kami mengecek kode</a>
        </p>
      </div>
      <figure class="hero__figure">
        <div class="slot slot--4x5">
          <ResponsivePhoto photo={photos.hero} sizes={heroSizes} eager />
        </div>
        <figcaption class="caption">Program {latest.name} dicek <time datetime={latest.checkedAt}>{formatIdDate(latest.checkedAt)}</time>. Kode {latest.code}.</figcaption>
      </figure>
    </div>
  </section>

  <section class="band field" aria-labelledby="catatan">
    <div class="container band__grid">
      <p class="statement" id="catatan">Setiap kode punya tanggal cek dan sumber.</p>
      <div class="band__record">
        <p class="band__label">Brand aktif</p>
        <p class="band__brand"><a href={`/kode-referral/${latest.slug}/`}>{latest.name}</a></p>
        <p class="band__code">{latest.code}</p>
        <p class="band__date">Program dicek {formatIdDate(latest.checkedAt)}</p>
        <a class="btn" href="/kode-referral/">Lihat semua kode</a>
      </div>
    </div>
  </section>

  <section class="process">
    <div class="container">
      <div class="section-head">
        <h2>Cara kami mengecek kode referral.</h2>
        <p>Tiga langkah, dengan pengecekan ulang berkala.</p>
      </div>
      <ol class="steps">
        <li>
          <h3>Buka halaman program resmi</h3>
          <p>Kami baca halaman program, pusat bantuan, dan toko aplikasi brand.</p>
        </li>
        <li>
          <h3>Catat bonus dan syarat</h3>
          <p>Kami catat pengguna baru, minimum transaksi, dan masa berlaku.</p>
        </li>
        <li>
          <h3>Tandai entri lewat 30 hari</h3>
          <p>Entri yang lewat 30 hari masuk daftar pengecekan ulang. Kalau program berubah, status kode diperbarui.</p>
        </li>
      </ol>
      <p class="source-line"><a class="text-link" href="/metodologi-verifikasi/">Baca cara pengecekan lengkap</a></p>
    </div>
  </section>

  <section class="split">
    <div class="container split__grid">
      <figure class="split__figure">
        <div class="slot slot--4x3">
          <ResponsivePhoto photo={photos.split} sizes="(max-width: 60rem) 92vw, 42vw" />
        </div>
        <figcaption class="caption">Tanggal cek dicatat untuk setiap brand.</figcaption>
      </figure>
      <div class="split__copy">
        <h2>Urutan dari tanggal cek, bukan bonus.</h2>
        <p>Tabel diurutkan dari kode yang paling baru dicek, bukan dari bonus terbesar.</p>
        <a class="text-link" href="/metodologi-verifikasi/">Baca cara kami mengecek</a>
      </div>
    </div>
  </section>

  <section class="ledger">
    <div class="container">
      <div class="section-head">
        <h2>Kode referral aktif dan tanggal ceknya.</h2>
        <p>Diurutkan dari tanggal cek terbaru. Brand belum terverifikasi dan yang sudah berakhir tetap ada di direktori.</p>
      </div>
      <BrandTable items={ledgerBrands} caption="Brand aktif dengan kode referral dan tanggal cek" />
      <p class="source-line">Menampilkan brand aktif saja. <a class="text-link" href="/kode-referral/">Lihat semua kode</a> untuk entri lain.</p>
    </div>
  </section>

  <section class="categories" aria-labelledby="kategori">
    <div class="container">
      <div class="section-head">
        <h2 id="kategori">Cari kode referral per kategori.</h2>
        <p>Syaratnya berbeda di tiap layanan.</p>
      </div>
      <ul class="index-list">
        {activeCategories.map((category) => (
          <li class="index-row">
            <a href={categoryHref(category, brands)}>
              <span class="index-name">{category.name}</span>
              <span class="index-line">{category.line}</span>
              <span class="index-count">{brandsInCategory(brands, category.slug).length} brand</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="notes">
    <div class="container">
      <div class="section-head">
        <h2>Panduan sebelum memakai kode referral.</h2>
        <p>Baca soal syarat, keamanan, dan cara klaim bonus.</p>
      </div>
      <div class="notes__grid">
        <a class="feature" href={`/blog/${featuredArticle.slug}/`}>
          <div class="slot slot--4x3">
            <ResponsivePhoto photo={photos.blog} sizes="(max-width: 60rem) 92vw, 30vw" />
          </div>
          <h3>{featuredArticle.title}</h3>
          <p class="meta">{blogCategoryName(featuredArticle.category)}, diperbarui <time datetime={featuredArticle.updated}>{formatIdDate(featuredArticle.updated)}</time></p>
        </a>
        <div class="blog-list">
          {moreArticles.map((article) => (
            <a class="blog-row" href={`/blog/${article.slug}/`}>
              <h3>{article.title}</h3>
              <p>{blogCategoryName(article.category)}, diperbarui {formatIdDate(article.updated)}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="band band--close field">
    <div class="container band__grid">
      <div class="band--close__copy">
        <h2>Cari kode referral brand yang kamu pakai.</h2>
        <p>Cek syarat dan bonus sebelum mendaftar.</p>
      </div>
      <div class="band__search">
        <SearchForm id="band-search" variant="band" />
      </div>
    </div>
  </section>
</BaseLayout>
