---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchForm from '../components/SearchForm.astro';
import BrandTable from '../components/BrandTable.astro';
import { blogCategoryName } from '../data/blog-categories';
import { formatIdDate, photos } from '../data/site';
import {
  brandsInCategory,
  categoriesWithBrands,
  getArticles,
  getBrands,
  sortBrandsByChecked,
} from '../lib/content';
import { categoryHref, isDirectoryIndexable } from '../lib/policy';

const brands = await getBrands();
const articles = await getArticles();
const sorted = sortBrandsByChecked(brands);
const latest = sorted[0];
const ledgerBrands = sorted.slice(0, 7);
const activeCategories = categoriesWithBrands(brands);
const featuredArticle = articles[0];
const moreArticles = articles.slice(1);
const robots = isDirectoryIndexable(brands) ? 'index' : 'noindex';
const origin = Astro.site ?? new URL('https://kode-referral.example');

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Direktori kode referral Indonesia',
    url: new URL('/', origin).toString(),
    inLanguage: 'id',
    isPartOf: { '@type': 'WebSite', name: 'KodeReferral', url: new URL('/', origin).toString() },
  },
  {
    '@type': 'ItemList',
    name: 'Kode referral dengan tanggal cek terbaru',
    numberOfItems: ledgerBrands.length,
    itemListElement: ledgerBrands.map((brand, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `Kode referral ${brand.name}`,
      url: new URL(`/kode-referral/${brand.slug}/`, origin).toString(),
    })),
  },
];
---

<BaseLayout jsonLd={jsonLd} robots={robots}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1>Kode referral, bukan teka-teki.</h1>
        <p class="hero__lead">Kami catat kode, tanggal cek, dan syaratnya.</p>
        <SearchForm id="hero-search" />
        <p class="hero__facts">{brands.length} brand di {activeCategories.length} kategori. Semua bertanggal cek.</p>
        <p class="hero__links">
          <a class="text-link" href="/kode-referral/">Lihat semua {brands.length} brand</a>
          <a class="text-link" href="/metodologi-verifikasi/">Cara kami mengecek</a>
        </p>
      </div>
      <figure class="hero__figure">
        <div class="slot slot--4x5" data-slot="hero" data-alt={photos.hero.alt}>
          <img
            src={photos.hero.src}
            alt={photos.hero.alt}
            width="1920"
            height="1282"
            style={`object-position: ${photos.hero.position}`}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption class="caption">Program {latest.name} dicek {formatIdDate(latest.checkedAt)}. Kode {latest.code}.</figcaption>
      </figure>
    </div>
  </section>

  <section class="band field" aria-labelledby="catatan">
    <div class="container band__grid">
      <p class="statement" id="catatan">Kode yang tidak dicatat tanggal ceknya adalah iklan.</p>
      <div class="band__record">
        <p class="band__label">Cek terbaru</p>
        <p class="band__brand"><a href={`/kode-referral/${latest.slug}/`}>{latest.name}</a></p>
        <p class="band__code">{latest.code}</p>
        <p class="band__date">Program dicek {formatIdDate(latest.checkedAt)}</p>
        <a class="btn" href="/kode-referral/">Buka direktori</a>
      </div>
    </div>
  </section>

  <section class="process">
    <div class="container">
      <div class="section-head">
        <h2>Cara kami mengecek.</h2>
        <p>Tiga langkah, diulang setiap minggu.</p>
      </div>
      <ol class="steps">
        <li>
          <h3>Buka halaman program resmi</h3>
          <p>Kami baca halaman program, pusat bantuan, dan toko aplikasi brand.</p>
        </li>
        <li>
          <h3>Catat syarat dan bonus</h3>
          <p>Akun baru, minimum transaksi, dan masa berlaku dicatat apa adanya.</p>
        </li>
        <li>
          <h3>Ulangi tiap minggu</h3>
          <p>Entri yang tidak lagi cocok dengan program resmi ditandai, bukan dibiarkan aktif.</p>
        </li>
      </ol>
      <p class="source-line"><a class="text-link" href="/metodologi-verifikasi/">Baca metodologi lengkap</a></p>
    </div>
  </section>

  <section class="split">
    <div class="container split__grid">
      <figure class="split__figure">
        <div class="slot slot--4x3" data-slot="split" data-alt={photos.split.alt}>
          <img
            src={photos.split.src}
            alt={photos.split.alt}
            width="1920"
            height="1280"
            style={`object-position: ${photos.split.position}`}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="caption">Tanggal cek dicatat per brand, bukan per kampanye.</figcaption>
      </figure>
      <div class="split__copy">
        <h2>Tanggal cek lebih berguna daripada janji bonus.</h2>
        <p>Urutan tabel mengikuti tanggal cek terakhir, bukan nilai bonus yang dijanjikan.</p>
        <a class="text-link" href="/metodologi-verifikasi/">Baca metodologi</a>
      </div>
    </div>
  </section>

  <section class="ledger">
    <div class="container">
      <div class="section-head">
        <h2>Tujuh brand terbaru, tanggal cek terbaca.</h2>
        <p>Diurutkan dari yang terbaru.</p>
      </div>
      <BrandTable items={ledgerBrands} caption="Brand dengan kode referral dan tanggal cek terbaru" />
      <p class="source-line">Tanggal cek diperbarui saat halaman program ditinjau ulang. <a class="text-link" href="/kode-referral/">Buka direktori</a>.</p>
    </div>
  </section>

  <section class="categories" aria-labelledby="kategori">
    <div class="container">
      <div class="section-head">
        <h2 id="kategori">Pilih kategori.</h2>
        <p>Syaratnya berbeda di tiap layanan.</p>
      </div>
      <ul class="index-list">
        {activeCategories.map((category) => (
          <li class="index-row">
            <a href={categoryHref(category, brands)}>
              <span class="index-name">{category.name}</span>
              <span class="index-line">{category.line}</span>
              <span class="index-count">{brandsInCategory(brands, category.slug).length} brand</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="notes">
    <div class="container">
      <div class="section-head">
        <h2>Bacaan sebelum memakai kode.</h2>
        <p>Tiga catatan soal syarat, keamanan, dan bonus.</p>
      </div>
      <div class="notes__grid">
        <a class="feature" href={`/blog/${featuredArticle.slug}/`}>
          <div class="slot slot--4x3" data-slot="notes" data-alt={photos.blog.alt}>
            <img
              src={photos.blog.src}
              alt={photos.blog.alt}
              width="1920"
              height="1280"
              style={`object-position: ${photos.blog.position}`}
              loading="lazy"
              decoding="async"
            />
          </div>
          <h3>{featuredArticle.title}</h3>
          <p class="meta">{blogCategoryName(featuredArticle.category)}, diperbarui {formatIdDate(featuredArticle.updated)}</p>
        </a>
        <div class="blog-list">
          {moreArticles.map((article) => (
            <a class="blog-row" href={`/blog/${article.slug}/`}>
              <h3>{article.title}</h3>
              <p>{blogCategoryName(article.category)}, diperbarui {formatIdDate(article.updated)}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="band band--close field">
    <div class="container band__grid">
      <div class="band--close__copy">
        <h2>Mulai dari brand yang kamu pakai.</h2>
        <p>Cari kodenya, lalu baca syarat sebelum mendaftar.</p>
      </div>
      <div class="band__search">
        <SearchForm id="band-search" variant="band" />
      </div>
    </div>
  </section>
</BaseLayout>
