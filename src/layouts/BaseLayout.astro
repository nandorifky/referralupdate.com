---
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { defaultOgImage, PREVIEW, site, type OgImage } from '../data/site';

type Props = {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  robots?: 'index' | 'noindex';
  image?: OgImage;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
  author?: string;
  canonical?: string | null;
  preloadImage?: { href: string; srcset?: string; sizes?: string };
};

const {
  title,
  description = site.description,
  ogType = 'website',
  robots = 'index',
  image = defaultOgImage,
  jsonLd,
  publishedTime,
  modifiedTime,
  section,
  tags,
  author,
  canonical: canonicalOverride,
  preloadImage,
} = Astro.props;
const robotsContent =
  PREVIEW || robots === 'noindex' ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const pageTitle = title
  ? title.includes(site.name)
    ? title
    : `${title} | ${site.name}`
  : `${site.name}: direktori kode referral Indonesia`;
const origin = Astro.site ?? new URL('https://referralupdate.com');
const canonical =
  canonicalOverride === null
    ? null
    : new URL(canonicalOverride ?? Astro.url.pathname, origin).toString();
const rootUrl = new URL('/', origin).toString();
const ogImageUrl = new URL(image.path, origin).toString();
const organizationId = `${rootUrl}#organization`;
const websiteId = `${rootUrl}#website`;
const baseLd = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    name: site.name,
    url: rootUrl,
    inLanguage: 'id',
    description: site.description,
    publisher: { '@id': organizationId },
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${new URL('/kode-referral/', origin).toString()}?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@type': 'Organization',
    '@id': organizationId,
    name: site.name,
    url: rootUrl,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/brand-mark-512.png', origin).toString(),
      width: 512,
      height: 512,
    },
    description: 'Direktori independen kode referral untuk layanan digital di Indonesia.',
  },
];
const structured = {
  '@context': 'https://schema.org',
  '@graph': [...baseLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])],
};
const structuredJson = JSON.stringify(structured).replace(/</g, '\\u003c');
const isArticle = ogType === 'article';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/brand-mark.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical ?? new URL(Astro.url.pathname, origin).toString()} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={image.alt} />
    {isArticle && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {isArticle && (modifiedTime ?? publishedTime) && (
      <meta property="article:modified_time" content={(modifiedTime ?? publishedTime)!} />
    )}
    {isArticle && section && <meta property="article:section" content={section} />}
    {isArticle && tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    {isArticle && modifiedTime && (
      <meta property="og:updated_time" content={modifiedTime} />
    )}
    {author && <meta name="author" content={author} />}
    {isArticle && author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    <meta name="theme-color" content="#f8f7f3" />
    <meta name="color-scheme" content="light" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} RSS`}
      href={new URL('/rss.xml', origin).toString()}
    />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.href}
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        fetchpriority="high"
      />
    )}
    <link rel="preload" href="/fonts/radio-canada.v1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/radio-canada-big.v1.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={structuredJson} />
  </head>
  <body>
    <a class="skip" href="#main">Lewati ke konten</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const copyButtons = document.querySelectorAll('[data-copy]');
      copyButtons.forEach((button) => {
        button.addEventListener('click', async () => {
          const code = button.getAttribute('data-copy') || '';
          const status = button.closest('.code-card')?.querySelector('[data-copy-status]');
          try {
            await navigator.clipboard.writeText(code);
            const previous = button.textContent;
            button.textContent = 'Tersalin';
            if (status) status.textContent = `Kode ${code} tersalin.`;
            window.setTimeout(() => {
              button.textContent = previous;
              if (status) status.textContent = '';
            }, 1800);
          } catch {
            button.textContent = 'Salin manual';
            if (status) status.textContent = `Salin kode secara manual: ${code}`;
          }
        });
      });

      const filter = document.querySelector('[data-filter]');
      if (filter) {
        const query = filter.querySelector('input[name="q"]');
        const category = filter.querySelector('select[name="kategori"]');
        const rows = [...document.querySelectorAll('[data-brand-row]')];
        const count = document.querySelector('[data-filter-count]');
        const empty = document.querySelector('[data-filter-empty]');
        const params = new URLSearchParams(window.location.search);
        if (query && params.get('q')) query.value = params.get('q');
        if (category && params.get('kategori')) category.value = params.get('kategori');
        const apply = () => {
          const term = (query?.value || '').trim().toLowerCase();
          const chosen = category?.value || '';
          let visible = 0;
          rows.forEach((row) => {
            const matchesText = !term || (row.dataset.name || '').includes(term) || row.textContent.toLowerCase().includes(term);
            const matchesCategory = !chosen || row.dataset.category === chosen;
            row.hidden = !(matchesText && matchesCategory);
            if (!row.hidden) visible += 1;
          });
          if (count) count.textContent = `${visible} brand`;
          if (empty) empty.hidden = visible !== 0;
          const url = new URL(window.location.href);
          if (term) url.searchParams.set('q', term);
          else url.searchParams.delete('q');
          if (chosen) url.searchParams.set('kategori', chosen);
          else url.searchParams.delete('kategori');
          window.history.replaceState(null, '', url);
        };
        query?.addEventListener('input', apply);
        category?.addEventListener('change', apply);
        filter.addEventListener('submit', (event) => {
          event.preventDefault();
          apply();
        });
        apply();
      }
    </script>
  </body>
</html>
