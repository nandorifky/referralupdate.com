---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { homeCrumb, routes } from '../data/routes';
import { breadcrumbLd, siteIds, siteOrigin } from '../data/site';

type Props = {
  title: string;
  description: string;
  lead: string;
  path: string;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage';
};

const { title, description, lead, path, pageType = 'WebPage' } = Astro.props;
const origin = siteOrigin(Astro.site);
const pageUrl = new URL(path, origin).toString();
const { website: websiteId, organization: organizationId } = siteIds(origin);
const webpageId = `${pageUrl}#webpage`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const jsonLd = [
  breadcrumbLd([homeCrumb, { name: title, path }], origin, breadcrumbId),
  {
    '@type': pageType,
    '@id': webpageId,
    name: title,
    description,
    url: pageUrl,
    inLanguage: 'id',
    isPartOf: { '@id': websiteId },
    publisher: { '@id': organizationId },
    breadcrumb: { '@id': breadcrumbId },
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="page-head">
    <div class="container">
      <Breadcrumb
        items={[
          { label: routes.home.label, href: routes.home.href },
          { label: title },
        ]}
      />
      <div class="page-head__body">
        <h1>{title}.</h1>
        <p class="lead">{lead}</p>
      </div>
    </div>
  </section>
  <div class="container">
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
