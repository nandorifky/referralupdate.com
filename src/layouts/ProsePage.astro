---
import BaseLayout from './BaseLayout.astro';
import { breadcrumbLd } from '../data/site';

type Props = {
  title: string;
  description: string;
  lead: string;
  path: string;
};

const { title, description, lead, path } = Astro.props;
const origin = Astro.site ?? new URL('https://kode-referral.example');
const jsonLd = breadcrumbLd(
  [
    { name: 'Beranda', path: '/' },
    { name: title, path },
  ],
  origin,
);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="container">
    <div class="prose-page">
      <section class="prose-head">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb">
            <li><a href="/">Beranda</a></li>
            <li>{title}</li>
          </ol>
        </nav>
        <div class="prose-page__head">
          <h1>{title}.</h1>
          <p class="lead">{lead}</p>
        </div>
      </section>
      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
