---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { homeCrumb, routes } from '../data/routes';
import { breadcrumbLd, siteOrigin } from '../data/site';

type Props = {
  title: string;
  description: string;
  lead: string;
  path: string;
};

const { title, description, lead, path } = Astro.props;
const origin = siteOrigin(Astro.site);
const jsonLd = breadcrumbLd([homeCrumb, { name: title, path }], origin);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="page-head">
    <div class="container">
      <Breadcrumb
        items={[
          { label: routes.home.label, href: routes.home.href },
          { label: title },
        ]}
      />
      <div class="page-head__body">
        <h1>{title}.</h1>
        <p class="lead">{lead}</p>
      </div>
    </div>
  </section>
  <div class="container">
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
