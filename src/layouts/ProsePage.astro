---
import BaseLayout from './BaseLayout.astro';
import { breadcrumbLd } from '../data/site';

type Props = {
  title: string;
  description: string;
  lead: string;
  path: string;
};

const { title, description, lead, path } = Astro.props;
const origin = Astro.site ?? new URL('https://referralupdate.com');
const jsonLd = breadcrumbLd(
  [
    { name: 'Beranda', path: '/' },
    { name: title, path },
  ],
  origin,
);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="page-head">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Beranda</a></li>
          <li>{title}</li>
        </ol>
      </nav>
      <div class="page-head__body">
        <h1>{title}.</h1>
        <p class="lead">{lead}</p>
      </div>
    </div>
  </section>
  <div class="container">
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
