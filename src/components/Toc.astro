---
type Item = { href: string; label: string };

type Props = {
  items: Item[];
  label?: string;
};

const { items, label = 'Daftar isi' } = Astro.props;
---

{
  items.length > 1 && (
    <div class="toc" role="doc-toc" aria-labelledby="toc-title">
      <p class="toc__title" id="toc-title">{label}</p>
      <ol>
        {items.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style>
  /* Hallmark · component: toc · genre: editorial · theme: Grid (project) · states: 4/8 (static anchors; disabled, loading, error and success do not apply) · contrast: pass · v2.0.0 */
  /* Hallmark · pre-emit critique: P4 H5 E5 S4 R5 V4 · weakest: P, a contents list is a utility; the numbered ledger borrows the masthead index instead of adding chrome */
  .toc {
    margin-block: var(--space-xl);
  }

  .toc__title {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.4;
    margin: 0 0 var(--space-sm);
  }

  .toc ol {
    counter-reset: toc;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .toc li {
    counter-increment: toc;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .toc a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-md);
    align-items: baseline;
    min-height: 48px;
    padding-block: var(--space-sm);
    color: var(--color-ink);
    font-size: var(--text-md);
    line-height: 1.4;
    text-decoration: none;
  }

  .toc a::before {
    content: counter(toc, decimal-leading-zero);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-short) var(--ease-out);
  }

  .toc a:hover,
  .toc a:active {
    color: var(--color-mark);
  }

  .toc a:hover::before,
  .toc a:active::before {
    color: currentColor;
  }

  .toc a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  @media (max-width: 40rem) {
    .toc a {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      font-size: clamp(var(--text-sm), 3.5vw, var(--text-md));
    }

    .toc a::before {
      display: block;
      margin-bottom: var(--space-3xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc a::before {
      transition: none;
    }
  }
</style>
