---
import { Picture } from 'astro:assets';
import type { PhotoFrame } from '../data/site';

type Props = {
  photo: PhotoFrame;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  quality?: number;
};

const {
  photo,
  sizes,
  widths = [480, 640, 960, 1280, 1920],
  eager = false,
  quality = 68,
} = Astro.props;
---

<Picture
  src={photo.src}
  alt={photo.alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  quality={quality}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  style={`object-position: ${photo.position}`}
/>
