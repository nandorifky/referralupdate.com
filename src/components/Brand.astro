---
import { site } from '../data/site';

type Props = {
  size?: 'header' | 'panel' | 'footer';
};

const { size = 'header' } = Astro.props;
---

<a class:list={['brand', `brand--${size}`]} href="/" aria-label={`${site.name}, beranda`}>
  <img class="brand__mark" src="/brand-mark.svg" alt="" width="32" height="32" aria-hidden="true" />
  <span class="brand__word">{site.name}<span class="brand__dot" aria-hidden="true">.</span></span>
</a>
