---
import { getCategory } from '../data/categories';
import { formatIdDate } from '../data/site';
import type { Brand } from '../lib/content';

type Props = {
  items: Brand[];
  caption: string;
};

const { items, caption } = Astro.props;
---

<div class="table-wrap">
  <table class="brand-table">
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Brand</th>
        <th scope="col">Kode</th>
        <th scope="col">Kategori</th>
        <th scope="col">Yang didapat</th>
        <th scope="col">Program dicek</th>
      </tr>
    </thead>
    <tbody>
      {items.map((brand) => (
        <tr data-brand-row data-name={brand.name.toLowerCase()} data-category={brand.category}>
          <td data-label="Brand"><a href={`/kode-referral/${brand.slug}/`}>{brand.name}</a></td>
          <td data-label="Kode"><span class="table-code">{brand.code}</span></td>
          <td data-label="Kategori">{getCategory(brand.category)?.name}</td>
          <td data-label="Yang didapat">{brand.reward}</td>
          <td data-label="Program dicek">
            <span class="checked-chip">{formatIdDate(brand.checkedAt)}</span>
            {brand.status !== 'active' && (
              <span class="checked-status" data-status={brand.status}>
                {brand.status === 'expired' ? 'Berakhir' : 'Belum terverifikasi'}
              </span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
