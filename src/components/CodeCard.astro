---
import { getCategory } from '../data/categories';
import { formatIdDateShort, PREVIEW } from '../data/site';
import type { Brand } from '../lib/content';

type Props = {
  brand: Brand;
};

const { brand } = Astro.props;
const category = getCategory(brand.category);
const shortDate = formatIdDateShort(brand.checkedAt);
---

<aside class="code-card" aria-label={`Kode referral ${brand.name}`}>
  <div class="code-card__top">
    <p class="code-card__label">Kode {brand.name}, {category?.name}</p>
    <p class="code-card__date">Dicek {shortDate}</p>
  </div>
  <p class="code-card__code">{brand.code}</p>
  <p class="code-card__reward">{brand.reward}</p>
  <div class="code-card__foot">
    <button class="btn" type="button" data-copy={brand.code}>Salin kode</button>
    <span class="copy-status" data-copy-status role="status" aria-live="polite"></span>
  </div>
  {PREVIEW && <p class="code-card__note">Pratinjau: kode dan tanggal di kartu ini data contoh.</p>}
  <a class="code-card__link" href="/metodologi-verifikasi/">Cara kami mengecek</a>
</aside>
