---
import { ui } from '../data/copy';
import { getBrands } from '../lib/content';

type Props = {
  id: string;
  variant?: 'hero' | 'band';
  value?: string;
};

const { id, variant = 'hero', value = '' } = Astro.props;
const isBand = variant === 'band';
const brands = await getBrands();
---

<form class={`search search--${variant}`} action="/kode-referral/" method="get" role="search">
  <label for={id}>{ui.search.label}</label>
  <div class="search__row">
    <input
      id={id}
      name="q"
      type="search"
      placeholder={isBand ? ui.search.bandPlaceholder : ui.search.heroPlaceholder}
      value={value}
      list={`${id}-brand-options`}
      autocomplete="off"
      spellcheck="false"
    />
    <button class="btn" type="submit">{isBand ? ui.search.bandSubmit : ui.search.heroSubmit}</button>
  </div>
  <datalist id={`${id}-brand-options`}>
    {brands.map((brand) => <option value={brand.name}></option>)}
  </datalist>
</form>
