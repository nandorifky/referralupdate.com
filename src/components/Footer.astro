---
import { photoCredits, site } from '../data/site';
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__mark">
      <a class="wordmark wordmark--footer" href="/" aria-label="KodeReferral, beranda">KodeReferral<span class="wordmark__dot" aria-hidden="true">.</span></a>
      <p>Direktori independen kode referral untuk layanan di Indonesia.</p>
    </div>
    <nav class="site-footer__links" aria-label="Navigasi footer">
      {site.footer.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="site-footer__meta">
      <p>Pratinjau desain. Brand, kode, dan tanggal di halaman ini adalah data contoh.</p>
      <p>© 2026 KodeReferral</p>
      <p class="credits" data-credits>
        Foto: {photoCredits.map((photo, index) => (
          <><a href={photo.source} rel="noopener noreferrer" target="_blank">{photo.author} ({photo.license})</a>{index < photoCredits.length - 1 ? ', ' : '.'}</>
        ))}
      </p>
    </div>
  </div>
</footer>
