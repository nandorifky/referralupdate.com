---
import Brand from './Brand.astro';
import { photoCredits, site } from '../data/site';
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__mark">
      <Brand size="footer" />
      <p>{site.tagline}</p>
    </div>
    <nav class="site-footer__links" aria-label="Navigasi footer">
      {site.footer.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/rss.xml">RSS</a>
    </nav>
    <div class="site-footer__meta">
      <p>Kode dan syarat mengikuti halaman resmi di setiap entri. Tanggal cek tercatat di tiap halaman brand.</p>
      <p>© 2026 {site.name}</p>
      <p class="credits" data-credits>
        Foto: {photoCredits.map((photo, index) => (
          <><a href={photo.source} rel="noopener noreferrer" target="_blank">{photo.author} ({photo.license})</a>{index < photoCredits.length - 1 ? ', ' : '.'}</>
        ))}
      </p>
    </div>
  </div>
</footer>
