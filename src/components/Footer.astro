---
import Brand from './Brand.astro';
import { site } from '../data/site';
import { getPhotoCredits, type PhotoCredit } from '../lib/photos';

const credits = await getPhotoCredits();

function creditLabel(credit: PhotoCredit) {
  if (credit.author && credit.license) return `${credit.author} (${credit.license})`;
  if (credit.author) return credit.author;
  if (credit.license) return credit.license;
  return 'Sumber foto';
}
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__mark">
      <Brand size="footer" />
      <p>{site.tagline}</p>
    </div>
    <nav class="site-footer__links" aria-label="Navigasi footer">
      {site.footer.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/rss.xml">RSS</a>
    </nav>
    <div class="site-footer__meta">
      <p>Kode dan syarat mengikuti halaman resmi di setiap entri. Tanggal cek tercatat di tiap halaman brand.</p>
      <p>© 2026 {site.name}</p>
      {credits.length > 0 && (
        <p class="credits" data-credits>
          Foto: {credits.map((credit, index) => (
            <>
              {credit.source ? (
                <a href={credit.source} rel="noopener noreferrer" target="_blank">{creditLabel(credit)}</a>
              ) : (
                creditLabel(credit)
              )}
              {index < credits.length - 1 ? ', ' : '.'}
            </>
          ))}
        </p>
      )}
    </div>
  </div>
</footer>
