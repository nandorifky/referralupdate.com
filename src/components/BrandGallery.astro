---
import ResponsivePhoto from './ResponsivePhoto.astro';
import type { PhotoFrame } from '../data/site';

type GalleryPhoto = PhotoFrame & {
  caption: string;
  ratio?: 'auto' | '4:3' | '16:9' | '1:1' | '3:4';
  full?: boolean;
};

type Props = {
  items: GalleryPhoto[];
};

const { items } = Astro.props;
---

{items.length > 0 && (
  <ul class="brand-gallery">
    {items.map((photo) => {
      const ratio = photo.ratio ?? 'auto';
      return (
        <li class:list={{ 'brand-gallery__item--full': photo.full === true }}>
          <figure>
            {ratio === 'auto' ? (
              // Tanpa bingkai beraspek tetap: gambar memakai rasio asli berkas.
              // Atribut width/height dari <Picture> tetap menahan tinggi awal
              // supaya tidak ada layout shift.
              <div class="brand-gallery__frame">
                <ResponsivePhoto
                  photo={photo}
                  widths={[480, 640, 960, 1280]}
                  sizes="(max-width: 40rem) calc(100vw - 2rem), (max-width: 60rem) calc(50vw - 2rem), 44rem"
                />
              </div>
            ) : (
              <div class="slot" style={`aspect-ratio: ${ratio.replace(':', ' / ')}`}>
                <ResponsivePhoto
                  photo={photo}
                  widths={[320, 480, 640, 960]}
                  sizes="(max-width: 40rem) calc(100vw - 2rem), (max-width: 60rem) calc(50vw - 2rem), 24rem"
                />
              </div>
            )}
            <figcaption class="caption">{photo.caption}</figcaption>
          </figure>
        </li>
      );
    })}
  </ul>
)}
