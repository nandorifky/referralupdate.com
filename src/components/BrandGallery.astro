---
import ResponsivePhoto from './ResponsivePhoto.astro';
import type { PhotoFrame } from '../data/site';

type GalleryPhoto = PhotoFrame & { caption: string };

type Props = {
  items: GalleryPhoto[];
};

const { items } = Astro.props;
---

{items.length > 0 && (
  <ul class="brand-gallery">
    {items.map((photo) => (
      <li>
        <figure>
          <div class="slot slot--4x3">
            <ResponsivePhoto
              photo={photo}
              widths={[320, 480, 640, 960]}
              sizes="(max-width: 40rem) calc(100vw - 2rem), (max-width: 60rem) calc(50vw - 2rem), 24rem"
            />
          </div>
          <figcaption class="caption">{photo.caption}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
)}
